#!/usr/bin/env python3
"""
Hook pre-commit pour le système de versionnement des pipelines
Applique les règles définies dans documentation/creation-systeme-version-pipelines.md
"""

import os
import re
import subprocess
import sys
from pathlib import Path
from typing import List


class Colors:
    """Codes de couleur pour les messages de sortie"""

    RED = "\033[0;31m"
    GREEN = "\033[0;32m"
    YELLOW = "\033[1;33m"
    NC = "\033[0m"  # No Color


def error(message: str) -> None:
    """Affiche un message d'erreur coloré"""
    print(f"{Colors.RED}✗{Colors.NC} {message}", file=sys.stderr)


def warning(message: str) -> None:
    """Affiche un message d'avertissement coloré"""
    print(f"{Colors.YELLOW}⚠{Colors.NC} {message}", file=sys.stderr)


def success(message: str) -> None:
    """Affiche un message de succès coloré"""
    print(f"{Colors.GREEN}✓{Colors.NC} {message}")


def check_semver(filename: str) -> bool:
    """
    Vérifie si le nom de fichier suit le format SemVer
    Format attendu: nom-X.Y.Z(.extension) où X, Y, Z sont des nombres
    """
    pattern = r"-\d+\.\d+\.\d+"
    return bool(re.search(pattern, filename))


def file_has_previous_commits(filepath: str) -> bool:
    """
    Vérifie si un fichier a déjà été commité dans l'historique git
    """
    try:
        # Vérifier si le fichier existe dans l'historique git
        result = subprocess.run(
            ["git", "rev-list", "--count", "HEAD", "--", filepath],
            capture_output=True,
            text=True,
            check=False,
        )

        if result.returncode == 0:
            return int(result.stdout.strip()) >= 1

        return False
    except subprocess.SubprocessError:
        return False


def check_file_size(filepath: str, max_size_kb: int) -> bool:
    """
    Vérifie la taille d'un fichier en Ko
    """
    file_path = Path(filepath)
    if not file_path.exists():
        return False

    # Taille en Ko
    file_size_kb = file_path.stat().st_size // 1024
    return file_size_kb <= max_size_kb


def get_staged_files() -> List[str]:
    """
    Récupère la liste des fichiers modifiés/ajoutés dans le staging area
    """
    try:
        result_staged = subprocess.run(
            ["git", "diff", "--cached", "--name-only"],
            capture_output=True,
            text=True,
            check=True,
        )
        return [
            f.strip() for f in result_staged.stdout.strip().split("\n") if f.strip()
        ]
    except subprocess.SubprocessError:
        return []


def get_unstaged_files() -> List[str]:
    """Récupère la liste des fichiers modifiés qui n'ont pas été ajoutés à l'index"""
    try:
        result_unstaged = subprocess.run(
            ["git", "diff", "--name-only"],
            capture_output=True,
            text=True,
            check=True,
        )
        return [
            f.strip() for f in result_unstaged.stdout.strip().split("\n") if f.strip()
        ]
    except subprocess.SubprocessError:
        return []


def get_untracked_files() -> List[str]:
    """Récupère la liste des fichiers non suivis"""
    try:
        result_untracked = subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard"],
            capture_output=True,
            text=True,
            check=True,
        )
        return [
            f.strip() for f in result_untracked.stdout.strip().split("\n") if f.strip()
        ]
    except subprocess.SubprocessError:
        return []


def check_single_pipeline_rule(staged_files: List[str]) -> bool:
    """
    Vérifie que tous les fichiers stagés appartiennent au même pipeline
    """
    pipeline_files = [f for f in staged_files if "/" in f]

    pipelines = set()
    for filepath in pipeline_files:
        pipeline_name = get_pipeline_name(filepath)
        pipelines.add(pipeline_name)

    if len(pipelines) > 1:
        error(
            f"Tous les fichiers d'un commit doivent appartenir au même pipeline. Pipelines détectés: {', '.join(sorted(pipelines))}"
        )
        return False

    return True


def check_complete_pipeline_rule(staged_files: List[str]) -> bool:
    """
    Vérifie qu'aucun fichier ne manque dans l'index pour le pipeline concerné
    """
    pipeline_files = [f for f in staged_files if "/" in f]

    if not pipeline_files:
        error("Impossible d'ajouter un fichier à la racine du dossier pipelines.")
        return False

    # Identifier le pipeline concerné
    pipeline_name = get_pipeline_name(pipeline_files[0])

    # Récupérer les fichiers modifiés (staged + unstaged) du pipeline
    try:
        # Fichiers modifiés mais pas encore stagés
        result_unstaged = subprocess.run(
            ["git", "diff", "--name-only"],
            capture_output=True,
            text=True,
            check=True,
        )
        unstaged_files = [
            f.strip() for f in result_unstaged.stdout.strip().split("\n") if f.strip()
        ]

        # Fichiers non trackés
        result_untracked = subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard"],
            capture_output=True,
            text=True,
            check=True,
        )
        untracked_files = [
            f.strip() for f in result_untracked.stdout.strip().split("\n") if f.strip()
        ]

    except subprocess.SubprocessError:
        unstaged_files = []
        untracked_files = []

    # Filtrer les fichiers du pipeline concerné
    unstaged_pipeline_files = [
        f for f in unstaged_files if f.startswith(pipeline_name + "/")
    ]
    untracked_pipeline_files = [
        f for f in untracked_files if f.startswith(pipeline_name + "/")
    ]

    missing_files = []
    missing_files.extend(unstaged_pipeline_files)
    missing_files.extend(untracked_pipeline_files)

    if missing_files:
        error(
            f"Tous les fichiers modifiés du pipeline '{pipeline_name}' doivent être inclus dans le commit."
        )
        error(f"Fichiers manquants dans l'index: {', '.join(sorted(missing_files))}")
        warning("Utilisez 'git add <fichier>' pour ajouter ces fichiers à l'index.")
        return False

    success(
        f"Tous les fichiers du pipeline '{pipeline_name}' sont inclus dans le commit."
    )
    return True


def get_pipeline_name(filepath: str) -> str:
    """
    Extrait le nom du pipeline
    """
    return filepath.split("/")[0]


def validate_file(filepath: str) -> bool:
    """
    Valide un fichier selon les règles de versionnement des pipelines
    Retourne True si le fichier est valide, False sinon
    """

    pipeline_name = get_pipeline_name(filepath)

    print(f"Vérification: {filepath}")

    # Règle 1: $PIPELINE_NAME/launchers/*.sh - peut avoir autant de commits que souhaité
    if re.match(rf"^{pipeline_name}/launchers/.*\.sh$", filepath):
        success(f"Fichier launcher autorisé: {filepath}")
        return True

    # Règle 2: $PIPELINE_NAME/actions/*.sh - doit avoir une seule révision et suivre SemVer
    if re.match(rf"^{pipeline_name}/actions/.*\.sh$", filepath):
        filename = os.path.basename(filepath)

        # Vérifier le format SemVer
        if not check_semver(filename):
            error(
                f"Le fichier action {filepath} ne suit pas le format SemVer (Majeure.Mineure.Patch.sh)"
            )
            return False

        # Vérifier qu'il n'a pas déjà été commité
        if file_has_previous_commits(filepath):
            error(
                f"Le fichier action {filepath} a déjà été commité. Les actions ne peuvent avoir qu'une seule révision."
            )
            return False

        # Vérifier qu'il existe un fichier .md associé
        md_file = filepath.replace(".sh", ".md")
        if not Path(md_file).exists():
            error(
                f"Le fichier action {filepath} doit avoir un fichier de documentation associé: {md_file}"
            )
            return False

        success(f"Fichier action valide: {filepath}")
        return True

    # Règle 3: Fichiers .md dans actions - peuvent être modifiés, taille max 100Ko
    if re.match(rf"^{pipeline_name}/actions/.*\.md$", filepath):
        if not check_file_size(filepath, 100):
            error(
                f"Le fichier de documentation {filepath} dépasse la taille maximale de 100Ko"
            )
            return False

        success(f"Fichier de documentation action valide: {filepath}")
        return True

    # Règle 4: Tous les autres fichiers - doivent suivre SemVer et avoir une seule révision
    filename = os.path.basename(filepath)

    # Vérifier le format SemVer
    if not check_semver(filename):
        error(
            f"Le fichier {filepath} ne suit pas le format SemVer (Majeure.Mineure.Patch.extension)"
        )
        return False

    # Vérifier qu'il n'a pas déjà été commité
    if file_has_previous_commits(filepath):
        error(
            f"Le fichier {filepath} a déjà été commité. Tous les fichiers (sauf launchers et actions/*.md) ne peuvent avoir qu'une seule révision."
        )
        return False

    success(f"Fichier valide: {filepath}")
    return True


def print_rules() -> None:
    """Affiche les règles de versionnement des pipelines"""
    print()
    print("Règles de versionnement des pipelines:")
    print("• {nom_du_pipeline}/launchers/*.sh: révisions multiples autorisées")
    print(
        "• {nom_du_pipeline}/actions/*.sh: une seule révision, format SemVer requis, documentation .md obligatoire"
    )
    print(
        "• {nom_du_pipeline}/actions/*.md: révisions multiples autorisées, taille max 100Ko"
    )
    print("• Tous les autres fichiers: une seule révision, format SemVer requis")
    print()
    print("Règles de cohérence des commits:")
    print("• Tous les fichiers d'un commit doivent appartenir au même pipeline")
    print(
        "• Tous les fichiers modifiés d'un pipeline doivent être inclus dans le commit"
    )


def main() -> int:
    """Fonction principale du script"""
    staged_files = get_staged_files()

    if not staged_files:
        success("Aucun fichier à vérifier")
        return 0

    print("Vérification des règles de versionnement des pipelines...")

    has_errors = False

    # Vérification 1: Tous les fichiers ajoutés à l'index doivent appartenir au même pipeline
    if not check_single_pipeline_rule(staged_files):
        has_errors = True

    # Vérification 2: Tous les fichiers modifiés du pipeline doivent être inclus
    if not check_complete_pipeline_rule(staged_files):
        has_errors = True

    # Vérification 3: Règles de versionnement individuelles des fichiers
    for filepath in staged_files:
        if not validate_file(filepath):
            has_errors = True

    if has_errors:
        error("Le commit a été rejeté en raison d'erreurs de validation.")
        print_rules()
        return 1

    success("Toutes les vérifications sont passées avec succès!")
    return 0


if __name__ == "__main__":
    sys.exit(main())
