Bootstrap: docker
From: alpine:latest

%files
    target/x86_64-unknown-linux-musl/debug/mercure /bin/mercure
    target/x86_64-unknown-linux-musl/debug/routine /bin/routine
    target/x86_64-unknown-linux-musl/debug/admin /bin/admin
    static /static
    Rocket.toml /Rocket.toml

%startscript
    cd /
    mercure

