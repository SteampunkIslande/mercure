{% extends "base.html.j2" %}

{% block title %}Connexion | SMAUG{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block topbar_actions %}{% endblock %}

{% block content %}
<div class="auth-layout">
  <section class="auth-card" aria-labelledby="login-title">
    <p class="eyebrow">Espace sécurisé</p>
    <h1 id="login-title">Connexion</h1>
    <p>Accédez à vos analyses et à vos formulaires SMAUG.</p>

    <form id="login-form" class="form">
      <div class="field">
        <label for="usermail">Adresse e-mail</label>
        <input type="email" id="usermail" name="usermail" placeholder="prenom.nom@exemple.fr" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" placeholder="Votre mot de passe" autocomplete="current-password" required>
      </div>
      <div class="form-actions">
        <button id="login-button" class="btn" type="submit">Se connecter</button>
        <a class="btn btn-secondary" href="/smaug">Retour</a>
      </div>
    </form>
  </section>
</div>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/login.js"></script>
{% endblock %}
