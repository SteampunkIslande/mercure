{% extends "base.html.j2" %}

{% block title %}Connexion - Mercure{% endblock %}

{% block banner %}{% endblock %}

{% block content %}
    <div class="container">
        <h1 class="title">Connexion</h1>
        <form id="loginForm">
            <div>
                <label for="usermail">Adresse e-mail:</label>
                <input type="text" id="usermail" name="usermail" placeholder="Adresse e-mail" required>
            </div>
            <div>
                <label for="password">Mot de passe:</label>
                <input type="password" id="password" name="password" placeholder="Mot de passe" required>
            </div>
        </form>
        <a id="loginButton" class="btn btn-primary" onclick="onConnect()">Se connecter</a>
        <a href="/mercure" class="btn btn-secondary">Retour</a>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        async function onConnect() {
            const usermail = document.getElementById('usermail').value;
            const password = document.getElementById('password').value;

            try {
                const response = await fetch('/mercure/api/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ usermail, password })
                });

                if (response.status === 200) {
                    window.location.href = response.url;
                } else {
                    const data = await response.json();
                    showMessage("error", getApiMessage(data));
                }
            } catch (error) {
                showMessage("error", error);
            }
        }
        window.onload = function () {
            document.getElementById('loginForm').reset();
        };
    </script>
{% endblock %}
