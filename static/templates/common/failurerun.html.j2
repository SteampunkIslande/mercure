<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Echec de l'analyse</title>
    <link rel="stylesheet" type="text/css" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <script src="/static/scripts/json_list.js"></script>
    <script src="/static/scripts/show_message.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Echec de l'analyse</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger">
                    <span class="material-icons icon-align">logout</span>Déconnexion
                </a>
            </div>
        </div>
    </div>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>

    <!-- Avertissement pour pipeline archivé -->
    {% if pipeline_is_archived %}
    <div class="info-msg" style="display:block; background-color: #fff3cd; border-color: #ffeaa7; color: #856404; margin-bottom: 20px;">
        <strong>⚠️ Attention:</strong> Ce pipeline utilise une version archivée. La révision git du launcher a changé depuis la création du formulaire. Il est recommandé de demander à votre administrateur de mettre à jour le formulaire avec la version actuelle du pipeline.
    </div>
    {% endif %}

    {% if attempt.attempt_number == run.attempt_count %}
    <h2>Dernière tentative échouée</h2>
    {% else %}
    <h2>Tentative {{ attempt.attempt_number }} échouée</h2>
    {% endif %}
    <p>
    <p>L'analyse du run <strong>{{ run.run_name }}</strong> a échoué.</p>
    <h3>Raison</h3>
    <p>{{ fail_reason }}</p>

    <div style="margin-top: 30px; text-align: left;">
        <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/runs">Retour</a>
        {% if run.status == "Idle" %}
        <a id="analysis-retry" class="btn btn-primary" href="/mercure/show/run/{{ run.run_id }}">Voir la tentative
            actuelle</a>
        {% elif pipeline_is_archived %}
        <span class="btn btn-primary disabled" title="Impossible de relancer: pipeline archivé" style="cursor: not-allowed; opacity: 0.6;">Relancer l'analyse</span>
        {% else %}
        <a id="analysis-retry" class="btn btn-primary" onclick="retryAnalysis({{ run.run_id }})">Relancer
            l'analyse</a>
        {% endif %}
    </div>

    {% include 'common/runinfo' %}


    <script>

        // Retry logic
        async function retryAnalysis(run_id) {
            try {
                const resp = await fetch(`/mercure/api/retry/${run_id}`);
                if (resp.ok) {
                    const json = await resp.json();
                    if (json.data) {
                        location.href = `/mercure/show/run/${run_id}`;
                    } else {
                        alert('Relance de l\'analyse refusée');
                    }
                } else {
                    console.error('Erreur lors de la requête de retry', resp.status);
                }
            } catch (e) {
                console.error('Exception lors de la requête de retry', e.message);
            }
        }

        document.addEventListener('DOMContentLoaded', async function () {
            // Affichage des variables utilisateur (readonly)
            const userDefinedVars = {{ user_defined_vars_json | safe
        }};
        const currentUserDefinedVars = {{ attempt.user_defined_vars | tojson }};
        const container = document.getElementById('user-defined-vars');
        const advancedContainer = document.getElementById('user-defined-vars-advanced');
        let hasAdvancedVars = false;

        for (const [key, value] of Object.entries(userDefinedVars).sort()) {
            const isConstant = value && typeof value === 'object' && 'Constant' in value;

            const div = document.createElement('div');
            const label = document.createElement('label');
            label.innerHTML = `<strong>${key}</strong>: `;
            div.appendChild(label);
            div.appendChild(document.createTextNode(' '));
            const span = document.createElement('span');
            span.textContent = currentUserDefinedVars[key] || '';
            div.appendChild(span);

            if (isConstant) {
                advancedContainer.appendChild(div);
                hasAdvancedVars = true;
            } else {
                container.appendChild(div);
            }

        }

        if (hasAdvancedVars) {
            const toggleBtn = document.getElementById('toggle-advanced-btn');
            const advancedDiv = document.getElementById('advanced-vars-container');
            toggleBtn.style.display = 'inline-block';

            toggleBtn.addEventListener('click', function () {
                if (advancedDiv.style.display === 'none') {
                    advancedDiv.style.display = 'block';
                    toggleBtn.textContent = 'Masquer les paramètres avancés';
                } else {
                    advancedDiv.style.display = 'none';
                    toggleBtn.textContent = 'Afficher les paramètres avancés';
                }
            });
        }

        // Correction de l'affichage du séquenceur
        const seqnameDiv = document.getElementById('seq-name');
        const seqname = seqnameDiv.textContent;
        try {
            const resp = await fetch(`/mercure/api/prettify/seqname/${encodeURIComponent(seqname)}`);
            if (resp.ok) {
                const data = await resp.text();
                seqnameDiv.textContent = data;
            }
        } catch (e) {
            console.log("Erreur lors de la récupération du nom de séquenceur joli: " + e.message);
            // Pas gênant, dans tous les cas c'est le nom du dossier qui s'affichera
        }

    });

    </script>
</body>

</html>