{% extends "common/run_base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Échec de l’analyse | {{ run.run_name }}{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Analyse · échec</p>
    <h1>{{ run.run_name }}</h1>
    <p>{% if attempt.attempt_number == run.attempt_count %}Dernière tentative échouée{% else %}Tentative {{ attempt.attempt_number }} échouée{% endif %}</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/show/runs">{{ ui.icon("chart") }}Mes analyses</a>
    {% if run.status in ("Idle", "Pending", "Running") %}
    <a class="btn" href="/smaug/show/run/{{ run.run_id }}">{{ ui.icon("clock") }}Tentative actuelle</a>
    {% else %}
    <button type="button" class="btn" data-run-action="retry">{{ ui.icon("refresh") }}Relancer</button>
    {% endif %}
  </div>
</header>

<section class="panel" aria-labelledby="failure-title">
  <div class="panel-title">
    <div>{{ ui.icon("error", "section-icon") }}<h2 id="failure-title">Raison de l’échec</h2></div>
  </div>
  <p>{{ fail_reason }}</p>
</section>

{% include "common/runinfo.html.j2" %}
{% endblock %}
