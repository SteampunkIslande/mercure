{% extends "common/run_base.html.j2" %}

{% block title %}Echec de l'analyse{% endblock %}

{% block banner_text %}Echec de l'analyse{% endblock %}

{% block content %}
    {% if attempt.attempt_number == run.attempt_count %}
    <h2>Dernière tentative échouée</h2>
    {% else %}
    <h2>Tentative {{ attempt.attempt_number }} échouée</h2>
    {% endif %}
    <p>L'analyse du run <strong>{{ run.run_name }}</strong> a échoué.</p>
    <h3>Raison</h3>
    <p>{{ fail_reason }}</p>

    <div style="margin-top: 30px; text-align: left;">
        <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/runs">Retour</a>
        {% if run.status in ("Idle", "Pending", "Running") %}
        <a id="analysis-current" class="btn btn-primary" href="/mercure/show/run/{{ run.run_id }}">Voir la tentative actuelle</a>
        {% else %}
        <a id="analysis-reproduce" class="btn btn-secondary" onclick="restartRun('reproduce')">Reproduire à l'identique</a>
        <a id="analysis-retry-latest" class="btn btn-primary" onclick="restartRun('latest')">Relancer avec le pipeline corrigé</a>
        {% endif %}
    </div>

    {% include "common/runinfo.html.j2" %}
{% endblock %}
