{% extends "common/run_base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Run en cours | {{ run.run_name }}{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Analyse · en cours</p>
    <h1>{{ run.run_name }}</h1>
    <p>{{ form.name }}</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/show/runs">{{ ui.icon("chart") }}Mes analyses</a>
  </div>
</header>

<div class="run-layout">
  <div class="run-card">
    <section class="panel" aria-labelledby="progress-title">
      <div class="panel-title">
        <div>{{ ui.icon("clock", "section-icon") }}<h2 id="progress-title">Progression</h2></div>
      </div>
      <dl class="run-meta">
        <div class="info-row"><dt>Étape</dt><dd id="current-step"><em>Non renseignée</em></dd></div>
      </dl>
      <p class="info-label">Dernière ligne de sortie</p>
      <pre id="last-output-line" class="stdout is-empty">En attente de sortie…</pre>
      <p class="info-label">Avancement de l’étape</p>
      <div id="progress-container" class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="progress-bar" class="progress-bar">0%</div>
      </div>
      <div class="counters">
        <div class="counter"><span class="counter-label">Jobs en attente</span><span id="pending-jobs-count" class="counter-value">—</span></div>
        <div class="counter"><span class="counter-label">Jobs en cours</span><span id="running-jobs-count" class="counter-value">—</span></div>
        <div class="counter"><span class="counter-label">Étapes terminées</span><span id="done-jobs-count" class="counter-value">—</span></div>
      </div>
      <p id="watch-status" class="watch-status" role="status" hidden></p>
    </section>

    <section class="panel" aria-labelledby="jobs-title">
      <div class="jobs-head">
        <div>
          <h2 id="jobs-title">Jobs SLURM</h2>
          <small id="slurm-job-name">Aucun job SLURM associé</small>
        </div>
        <button id="refresh-btn" type="button" class="btn btn-secondary btn-sm">{{ ui.icon("refresh") }}Actualiser</button>
      </div>
      <p id="slurm-jobs-message" class="jobs-message">Chargement des informations SLURM…</p>
      <div class="table-scroll">
        <table id="slurm-jobs-table" class="data-table" hidden>
          <thead>
            <tr><th>ID</th><th>Nom</th><th>État</th><th>Écoulé</th><th>Limite</th><th>Nœuds</th><th>Nodelist</th><th>Raison</th></tr>
          </thead>
          <tbody id="slurm-jobs-body"></tbody>
        </table>
      </div>
    </section>
  </div>

  <aside class="run-card">
    {% include "common/runinfo.html.j2" %}
  </aside>
</div>
{% endblock %}
