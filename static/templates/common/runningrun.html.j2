<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <title>Run en cours d'analyse - {{ run.run_name }}</title>
    <link rel="stylesheet" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <style>
        .progress {
            background: #e9ecef;
            border-radius: 4px;
            overflow: hidden;
            height: 24px;
        }

        .progress-bar {
            background: #007bff;
            height: 100%;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            line-height: 24px;
        }
    </style>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Run en cours d'analyse<br><span> {{ run.run_name }}</span></span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger">
                    <span class="material-icons icon-align">logout</span>Déconnexion
                </a>
            </div>
        </div>
    </div>

    <div class="field">
        <strong>Étape:</strong> <span id="current-step"><em>Non renseignée</em></span>
    </div>

    <div class="field">
        <strong>Progression:</strong>
        <div id="progress-container">
            <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="progress-bar" class="progress-bar" style="width:0%">0%</div>
            </div>
        </div>
    </div>

    <div class="field">
        <span><strong>Nombre de jobs SLURM en attente pour ce pipeline:</strong>
            <div id="pending-jobs-count"></div>
        </span>
    </div>
    <div class="field">
        <span><strong>Nombre de jobs SLURM en cours d'exécution pour ce
                pipeline:</strong>
            <div id="running-jobs-count"></div>
        </span>
    </div>

    {% include 'common/slurm_show' %}


    <div id="run-details" style="display: flex;">
        <div id="basic-info" style="flex: 1;">
            <h2>Détails du run</h2>
            <div>
                <label><strong>Nom du run:</strong></label>
                <span>{{ run.run_name }}</span>
            </div>
            <div>
                <label><strong>Date du run:</strong></label>
                <span>{{ run.run_date }}</span>
            </div>
            <div>
                <label><strong>Séquenceur:</strong></label>
                <span id="seq-name">{{ run.run_sequencer }}</span>
            </div>
            <div>
                <label><strong>Flowcell ID:</strong></label>
                <span>{{ run.run_flowcellid }}</span>
            </div>
        </div>

        <div id="attempts" style="display: flex; flex-direction: column; flex: 1; margin-left: 20px;">
            <h2>Tentatives</h3>
                <div class="attempt-list">
                    {% include 'common/attemptlist' %}
                </div>
        </div>
    </div>

    <h3>Variables définies par l'utilisateur</h3>
    <div id="user-defined-vars"></div>

    <div id="advanced-vars-container" style="display:none;">
        <h4 style="margin-top: 15px; color: #666;">Paramètres avancés (constantes du pipeline)</h4>
        <div id="user-defined-vars-advanced"></div>
    </div>

    <div style="margin-top: 10px;">
        <button id="toggle-advanced-btn" class="btn btn-secondary"
            style="font-size: 0.8em; padding: 5px 10px; display: none;">
            Afficher les paramètres avancés
        </button>
    </div>

    <div style="border:1px solid #ccc; padding:10px; margin-top:20px;margin-bottom:10px; background-color:#f9f9f9;">

        <label><strong>Sample sheet ADN:</strong></label>
        {% if samplesheet_adn_static_name %}
        <a href="{{ samplesheet_adn_static_name | safe }}" download>Télécharger la samplesheet ADN</a>
        {% else %}
        <span>Aucune sample sheet ADN fournie.</span>
        {% endif %}
        <br>
        <label><strong>Sample sheet ARN:</strong></label>
        {% if samplesheet_arn_static_name %}
        <a href="{{ samplesheet_arn_static_name | safe }}" download>Télécharger la samplesheet ARN</a>
        {% else %}
        <span>Aucune sample sheet ARN fournie.</span>
        {% endif %}
        <br>
        <label><strong>Fichier metadata:</strong></label>
        {% if metadata_static_name %}
        <a href="{{ metadata_static_name | safe }}" download>Télécharger le fichier metadata</a>
        {% else %}
        <span>Aucun fichier metadata fourni.</span>
        {% endif %}
        <br>
    </div>

    <div style="margin-top: 30px; text-align: left;">
        <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/runs">Retour</a>
    </div>

    <script>
        const runId = {{ run.run_id }};
        const attemptNumber = {{ attempt.attempt_number }};

        let intervalId = null;

        function setProgress(percent) {
            const p = Math.max(0, Math.min(100, Number(percent) || 0));
            const bar = document.getElementById('progress-bar');
            bar.style.width = p + '%';
            bar.textContent = p + '%';
            bar.parentElement.setAttribute('aria-valuenow', String(p));
        }

        async function updateJobInfo(info) {
            const stepEl = document.getElementById('current-step');
            if (info && info.current_step_string) stepEl.textContent = info.current_step_string;
            else stepEl.innerHTML = '<em>Non renseignée</em>';

            if (info) setProgress(info.current_progress);

            const pendingCountEl = document.getElementById("pending-jobs-count")
            if (info && info.pending_jobs_count) pendingCountEl.textContent = info.pending_jobs_count;
            else pendingCountEl.textContent = "Inconnu"

            const runningCountEl = document.getElementById("running-jobs-count")
            if (info && info.running_jobs_count) runningCountEl.textContent = info.running_jobs_count;
            else runningCountEl.textContent = "Inconnu"

            slurm_job_name = info.slurm_job_name;
            await refreshData(slurm_job_name);

        }

        async function pollJobInfo() {
            const url = `/mercure/api/watch/${runId}/${attemptNumber}`;
            try {
                const response = await fetch(url);
                const data = await response.json();

                if (data && data.success && data.data) {
                    await updateJobInfo(data.data);
                } else {
                    await updateJobInfo(null);
                }
            }
            catch (e) {
                console.warn('Erreur lors de la récupération des infos job', err);
                await updateJobInfo(null);
            }
        }

        window.addEventListener('beforeunload', () => {
            if (intervalId) {
                clearInterval(intervalId);
            }
        });

        document.addEventListener('DOMContentLoaded', async function () {
            // Affichage des variables utilisateur (readonly)
            const userDefinedVars = {{ user_defined_vars_json | safe
        }};
        const currentUserDefinedVars = {{ attempt.user_defined_vars | tojson }};
        const container = document.getElementById('user-defined-vars');
        const advancedContainer = document.getElementById('user-defined-vars-advanced');
        let hasAdvancedVars = false;

        for (const [key, value] of Object.entries(userDefinedVars).sort()) {
            const isConstant = value && typeof value === 'object' && 'Constant' in value;

            const div = document.createElement('div');
            const label = document.createElement('label');
            label.innerHTML = `<strong>${key}</strong>: `;
            div.appendChild(label);
            div.appendChild(document.createTextNode(' '));
            const span = document.createElement('span');
            span.textContent = currentUserDefinedVars[key] || '';
            div.appendChild(span);

            if (isConstant) {
                advancedContainer.appendChild(div);
                hasAdvancedVars = true;
            } else {
                container.appendChild(div);
            }

        }

        if (hasAdvancedVars) {
            const toggleBtn = document.getElementById('toggle-advanced-btn');
            const advancedDiv = document.getElementById('advanced-vars-container');
            toggleBtn.style.display = 'inline-block';

            toggleBtn.addEventListener('click', function () {
                if (advancedDiv.style.display === 'none') {
                    advancedDiv.style.display = 'block';
                    toggleBtn.textContent = 'Masquer les paramètres avancés';
                } else {
                    advancedDiv.style.display = 'none';
                    toggleBtn.textContent = 'Afficher les paramètres avancés';
                }
            });
        }

        // Correction de l'affichage du séquenceur
        const seqnameDiv = document.getElementById('seq-name');
        const seqname = seqnameDiv.textContent;
        try {
            const resp = await fetch(`/mercure/api/prettify/seqname/${encodeURIComponent(seqname)}`);
            if (resp.ok) {
                const data = await resp.text();
                seqnameDiv.textContent = data;
            }
        } catch (e) {
            console.log("Erreur lors de la récupération du nom de séquenceur joli: " + e.message);
            // Pas gênant, dans tous les cas c'est le nom du dossier qui s'affichera
        }

        intervalId = setInterval(pollJobInfo, 30000);
        await pollJobInfo();
        }
        );


    </script>
</body>

</html>