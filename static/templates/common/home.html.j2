{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}SMAUG — Tableau de bord{% endblock %}
{% block body_class %}dashboard-page{% endblock %}

{% block topbar_search %}
<div class="top-search">
  {{ ui.icon("search") }}
  <input id="globalSearch" aria-label="Rechercher un formulaire" placeholder="Rechercher un formulaire ou une analyse…">
</div>
{% endblock %}

{% block content %}
<section class="hero" aria-labelledby="welcome-title">
  <div class="hero-text">
    <h1 id="welcome-title">Bienvenue, <span>{{ user.username }}</span></h1>
    <p>Sur la plateforme SMAUG, dédiée aux analyses de données en génomique</p>
    <span class="hero-red-stroke" aria-hidden="true"></span>
  </div>
  <div class="hero-motto" aria-label="Analyser, comprendre, partager, au service de la génomique">
    <span>ANALYSER</span>
    <span>COMPRENDRE</span>
    <span>PARTAGER</span>
    <span class="motto-break">AU SERVICE</span>
    <span>DE LA GÉNOMIQUE</span>
    <span class="motto-stroke" aria-hidden="true"></span>
  </div>
</section>

<section id="categories" class="section modules" aria-labelledby="categories-title">
  <div class="section-heading">
    <div>
      <h2 id="categories-title">Lancer une analyse</h2>
      <p>Choisissez votre domaine ou retrouvez un formulaire ci-dessous.</p>
    </div>
    <button type="button" class="text-link" data-scroll-to="forms">Tous les formulaires {{ ui.icon("arrow") }}</button>
  </div>
  <div class="module-grid">
    <button type="button" class="module-card blue" data-category="demultiplexage">
      <span class="module-icon">{{ ui.icon("dna") }}</span>
      <span><strong>Démultiplexage</strong><p>Traitement des données de séquençage Illumina</p></span>
      {{ ui.icon("chev", "module-arrow") }}
    </button>
    <button type="button" class="module-card coral" data-category="genetique">
      <span class="module-icon">{{ ui.icon("dna") }}</span>
      <span><strong>Génétique constitutionnelle</strong><p>Analyses germinales, WES, WGS et panels</p></span>
      {{ ui.icon("chev", "module-arrow") }}
    </button>
    <button type="button" class="module-card violet" data-category="onco">
      <span class="module-icon">{{ ui.icon("nodes") }}</span>
      <span><strong>Onco-hématologie</strong><p>Analyses somatiques, CNA, CNV et MRD</p></span>
      {{ ui.icon("chev", "module-arrow") }}
    </button>
    <button type="button" class="module-card mint" data-category="immunologie">
      <span class="module-icon">{{ ui.icon("antibody") }}</span>
      <span><strong>Immunologie</strong><p>Analyses d’expression et immunogénomique</p></span>
      {{ ui.icon("chev", "module-arrow") }}
    </button>
    <a class="module-card amber" href="/smaug/show/runs">
      <span class="module-icon">{{ ui.icon("chart") }}</span>
      <span><strong>Suivi des analyses</strong><p>Runs, statuts, résultats et validations</p></span>
      {{ ui.icon("chev", "module-arrow") }}
    </a>
    <button type="button" class="module-card slate" data-category="autres">
      <span class="module-icon">{{ ui.icon("settings") }}</span>
      <span><strong>Autres outils</strong><p>QC, annotations, conversions et utilitaires</p></span>
      {{ ui.icon("chev", "module-arrow") }}
    </button>
  </div>
  <p id="categoryFeedback" class="panel-footnote" role="status" hidden></p>
</section>

<div class="bottom-grid">
  <section id="forms" class="panel" aria-labelledby="forms-title">
    <div class="panel-title">
      <div>{{ ui.icon("flask", "section-icon") }}<h2 id="forms-title">Formulaires disponibles</h2></div>
      <span id="availableCount" class="soft-badge"></span>
    </div>
    <div class="filterline">
      <label class="panel-search">
        {{ ui.icon("search") }}
        <input id="formSearch" aria-label="Rechercher un formulaire" placeholder="Rechercher un formulaire…">
      </label>
      <button type="button" id="resetFilters" class="filter-clear" hidden>Réinitialiser ×</button>
    </div>
    <div id="groupTabs" class="form-tabs" role="tablist" aria-label="Groupes autorisés"></div>
    <div id="formList" class="form-list" aria-live="polite">
      <p class="empty-state">Chargement des formulaires…</p>
    </div>
    <p id="no-user-group" class="panel-footnote" hidden>Vous n’appartenez à aucun groupe. Veuillez contacter votre administrateur système.</p>
  </section>

  <section id="runs" class="panel" aria-labelledby="runs-title">
    <div class="panel-title">
      <div>{{ ui.icon("chart", "section-icon") }}<h2 id="runs-title">Runs récents</h2></div>
      <a href="/smaug/show/runs" class="text-link">Voir tous mes runs {{ ui.icon("arrow") }}</a>
    </div>
    <div id="latest-runs-table" class="table-scroll" aria-live="polite"></div>
  </section>
</div>

<footer class="footer">
  <span>SMAUG · Suite Modulaire d’Analyses Unifiées en Génomique</span>
  <span>Interface de lancement et de suivi des analyses</span>
</footer>

<script type="application/json" id="page-data">{{ {"groups": user_groups, "isAdmin": user.is_admin} | tojson }}</script>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/home.js"></script>
{% endblock %}
