<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Forms</title>
    <link rel="stylesheet" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />

    <script src="/static/scripts/show_message.js"></script>
    <script src="/static/scripts/json_table.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Bienvenue, {{user.username }}</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>

    <script>
        function onDropDown(element) {
            document.getElementById(element).classList.toggle("show");
        }
        function navigateTo(uri) {
            window.location.href = uri;
        }

        // Close the dropdown menu if the user clicks outside of it
        window.onclick = function (event) {
            if (!event.target.matches('.dropbtn')) {
                var dropdowns = document.getElementsByClassName("dropdown-content");
                var i;
                for (i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }

        function openTab(evt, group_id) {
            // Declare all variables
            var i, tabcontent, tablinks;

            // Get all elements with class="tabcontent" and hide them
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            // Get all elements with class="tablinks" and remove the class "active"
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }

            // Show the current tab, and add an "active" class to the button that opened the tab
            document.getElementById(`forms-container-${group_id}`).style.display = "block";
            evt.currentTarget.className += " active";
        }

        const userGroups = {{ user_groups | tojson }};

        async function loadGroupForms() {
            if (userGroups.length > 0) {
                for (let group of userGroups) {
                    try {
                        const response = await fetch(`/mercure/api/forms/groups/${group.id}`);
                        const forms = await response.json();
                        // Always append to tbody if present, otherwise to table
                        let table = document.getElementById(`forms-container-${group.id}`);
                        let container = table.querySelector('tbody');
                        if (!container) {
                            console.log("No tbody found, appending to table directly");
                            container = table;
                        }
                        forms.data.with_group.forEach(form => {
                            if (form.enabled) {
                                const formBox = document.createElement('tr');
                                formBox.innerHTML = `
                           <td class="content-column">${form.form_name} (version ${form.version})</td>
                           <td class="numeric-column">
                               <a href="/mercure/runs/submit/${form.formid}" class="inline-table centered">Lancer un run</a>
                           </td>
                        `;
                                container.appendChild(formBox);
                            }
                        });
                    } catch (error) {
                        showMessage("error", `Error fetching forms ${error}`);
                    }
                }
            }
            else {
                console.log("User has no groups!");
                document.getElementById("no-user-group").style.display = "block";
            }
        }


        async function lastRuns() {
            try {
                // Permet d'afficher les cinq derniers runs de l'utilisateur (trié par date)
                const response = await fetch(`/mercure/api/listruns?page=1&page_size=5`);
                const json = await response.json();
                if (json.success) {
                    if (json.data.table.length > 0) {
                        generateJsonTable(json.data, "latest-runs-table");
                    } else {
                        document.getElementById("latest-runs-table").innerHTML = `<p>Aucune donnée à afficher.</p>`;
                    }
                } else {
                    showMessage("error", json.message || "Erreur inconnue");
                }
            } catch (e) {
                showMessage(`error", "Erreur: ${e}`);
            }
        }

        document.addEventListener('DOMContentLoaded', async function () {
            await loadGroupForms();
            await lastRuns();
        });

    </script>
    <div class="dropdown">
        <button onclick="navigateTo(`/mercure/show/runs`)" class="dropbtn"><span
                class="material-icons icon-align">science</span> Voir tous mes runs</button>
    </div>
    {% if is_admin %}
    <div class="dropdown" style="float:right;">
        <button onclick="navigateTo(`/mercure/admin/dashboard`)" class="dropbtn"><span
                class="material-icons icon-align">settings</span>Administration</button>
    </div>
    {% else %}
    <div class="dropdown" style="float:right;">
        <button onclick="navigateTo(`/mercure/passedit/{{ user.id }}`)" class="dropbtn"><span
                class="material-icons icon-align">key</span>Modifier le mot de passe</button>
    </div>
    {% endif %}

    <h1>Mes formulaires</h1>

    <div>
        <div class="tab">
            {% for group in user_groups %}

            <button id="tab-{{ group.id }}" class="tablinks{% if loop.first %} active {% endif %}"
                onclick="openTab(event,{{ group.id }})">{{ group.name
                }}</button>
            {% endfor %}
        </div>

        {% for group in user_groups %}
        <table id="forms-container-{{ group.id }}" class="tabcontent" {% if loop.first %} style="display: block;" {%
            endif %}>
            <tr>
                <th class="content-column">Nom du formulaire</th>
                <th class="numeric-column padding-x centered">Lancement d'un run</th>
            </tr>
        </table>
        {% endfor %}

    </div>
    <p id="no-user-group" style="display:none;">
        Vous n'appartenez à aucun groupe. Veuillez contacter votre administrateur système
    </p>

    <h1>Mes cinq derniers runs</h1>
    <div id="latest-runs-table">
    </div>

</body>

</html>