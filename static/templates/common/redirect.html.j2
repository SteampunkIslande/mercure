{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="state-page">
  <section class="state-card">
    <p class="eyebrow">Redirection</p>
    <h1>{{ title }}</h1>
    <p>{{ message }}</p>
    <p>Vous allez être redirigé dans <strong id="countdown" data-target="{{ target_url | e }}" data-seconds="{{ seconds }}">{{ seconds }}</strong> secondes. Si rien ne se passe, <a href="{{ target_url | e }}">cliquez ici</a>.</p>
  </section>
</div>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/redirect.js"></script>
{% endblock %}
