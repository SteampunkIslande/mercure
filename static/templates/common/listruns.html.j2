{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Liste des runs | SMAUG{% endblock %}
{% block body_class %}runs-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Analyses</p>
    <h1>Liste des runs</h1>
    <p>Suivez les analyses visibles par vos groupes.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/smaug/search/run">{{ ui.icon("search") }}Recherche avancée</a>
    <a class="btn btn-ghost" href="/smaug/home">{{ ui.icon("home") }}Accueil</a>
  </div>
</header>

<section class="panel" aria-labelledby="runs-title">
  <div class="panel-title">
    <div>{{ ui.icon("chart", "section-icon") }}<h2 id="runs-title">Runs</h2></div>
    <label class="field" for="status-filter">
      <span>Statut</span>
      <select id="status-filter">
        <option value="">Tous</option>
        <option value="Success">Succès</option>
        <option value="Failure">Échec</option>
        <option value="Pending">En attente</option>
        <option value="Running">Analyses en cours</option>
        <option value="Idle">À valider</option>
      </select>
    </label>
  </div>
  <div id="runs-table" class="table-scroll" aria-live="polite"></div>
  {{ ui.pagination() }}
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/runs.js"></script>
{% endblock %}
