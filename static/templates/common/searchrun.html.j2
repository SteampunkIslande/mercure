{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Recherche avancée | SMAUG{% endblock %}
{% block body_class %}runs-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Analyses</p>
    <h1>Recherche avancée</h1>
    <p>Filtrez les runs par nom, date ou statut.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/show/runs">{{ ui.icon("arrow-left") }}Retour à la liste</a>
  </div>
</header>

<section class="panel form-card" aria-labelledby="search-title">
  <div class="panel-title">
    <div>{{ ui.icon("search", "section-icon") }}<h2 id="search-title">Critères de recherche</h2></div>
  </div>
  <form id="search-form" class="form">
    <div class="form-grid">
      <div class="field">
        <label for="run_name_search">Nom du run</label>
        <input type="text" id="run_name_search" name="run_name_search" placeholder="Nom du run">
      </div>
      <div class="field">
        <label for="status">Statut</label>
        <select id="status" name="status">
          <option value="">Tous</option>
          <option value="Success">Succès</option>
          <option value="Failure">Échec</option>
          <option value="Pending">En attente</option>
          <option value="Running">Analyses en cours</option>
          <option value="Idle">À valider</option>
        </select>
      </div>
      <div class="field">
        <label for="date_from">Date de début</label>
        <input type="date" id="date_from" name="date_from">
      </div>
      <div class="field">
        <label for="date_to">Date de fin</label>
        <input type="date" id="date_to" name="date_to">
      </div>
      <div class="field">
        <label for="page_size">Résultats par page</label>
        <input type="number" id="page_size" name="page_size" min="1" max="100" value="10">
      </div>
    </div>
    <div class="form-actions">
      <button id="search-button" class="btn" type="submit">{{ ui.icon("search") }}Rechercher</button>
      <a class="btn btn-secondary" href="/smaug/show/runs">Annuler</a>
    </div>
  </form>
</section>

<section class="panel" aria-labelledby="results-title">
  <div class="panel-title">
    <div>{{ ui.icon("chart", "section-icon") }}<h2 id="results-title">Résultats</h2></div>
    <span id="results-count" class="soft-badge"></span>
  </div>
  <div id="search-results" class="table-scroll" aria-live="polite"></div>
  {{ ui.pagination() }}
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/search.js"></script>
{% endblock %}
