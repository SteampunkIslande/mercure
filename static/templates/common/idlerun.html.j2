<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Run en attente</title>
    <link rel="stylesheet" type="text/css" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <script src="/static/scripts/json_list.js"></script>
    <script src="/static/scripts/show_message.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Run en attente<br>{{ form.form_name }} (version {{ form.version }})</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger">
                    <span class="material-icons icon-align">logout</span>Déconnexion
                </a>
            </div>
        </div>
    </div>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>

    <!-- Avertissement pour pipeline archivé -->
    {% if pipeline_is_archived %}
    <div class="warning-msg">
        ⚠️ Attention: Ce pipeline utilise une version archivée. Vous ne pourrez pas valider ce run.
        En revanche, vous pouvez choisir un autre formulaire dans la liste ci-dessous.
        <span style="color:red">TODO!!!</span>
    </div>
    {% endif %}

    {% include 'common/runinfo' %}

    <div class="tab">
        <button id="tab-adn" class="tablinks active" onclick="openTab(event,'adn')">ADN</button>
        <button id="tab-arn" class="tablinks" onclick="openTab(event,'arn')">ARN</button>
        <button id="tab-metadata" class="tablinks" onclick="openTab(event,'metadata')">Metadata</button>
    </div>

    <div class="tabcontent" id="tabcontent-adn" style="display:block; overflow:auto; height:400px;">
        {% if not samplesheet_adn_static_name %}
        <span>Aucune sample sheet ADN fournie.</span>
        {% endif %}
        <input type="hidden" id="sample_sheet_adn_path" value="{{ run.sample_sheet_adn_path }}">
        <div id="sample_sheet_adn_check"></div>
        <div id="sample_sheet_adn_list" class="sample-list" style="overflow:auto;"></div>
    </div>

    <div class="tabcontent" id="tabcontent-arn" style="display:none; overflow:auto; height:400px;">
        {% if not samplesheet_arn_static_name %}
        <span>Aucune sample sheet ARN fournie.</span>
        {% endif %}
        <input type="hidden" id="sample_sheet_arn_path" value="{{ run.sample_sheet_arn_path }}">
        <div id="sample_sheet_arn_check"></div>
        <div id="sample_sheet_arn_list" class="sample-list" style="overflow:auto;"></div>
    </div>

    <div class="tabcontent" id="tabcontent-metadata" style="display:none; overflow:auto; height:400px;">
        {% if not run.metadata_file_path %}
        <span>Aucun fichier de métadonnées fourni.</span>
        {% else %}
        <a href="{{ run.metadata_file_static_name | safe }}" download>Télécharger le fichier de métadonnées</a>
        {% endif %}
    </div>


    <div style="margin-top: 30px; text-align: left;">
        <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/runs">Retour</a>
        {% if pipeline_is_archived %}
        <span class="btn btn-primary disabled" title="Impossible d'éditer: pipeline archivé"
            style="cursor: not-allowed; opacity: 0.6;">Editer</span>
        <span class="btn btn-primary disabled" title="Impossible de valider: pipeline archivé"
            style="cursor: not-allowed; opacity: 0.6;">Valider</span>
        <span>Vous devriez pouvoir choisir un autre formulaire dans la liste ci-dessous. TODO!!!!</span>
        {% else %}
        <a href="/mercure/editrun/{{ run_id }}" class="btn btn-primary">Editer</a>
        <a id="validate-btn" class="btn btn-primary">Valider</a>
        {% endif %}
    </div>

    <script>
        // Tabs
        function openTab(evt, tabName) {
            evt.preventDefault();
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            document.getElementById("tabcontent-" + tabName).style.display = "block";
            evt.currentTarget.className += " active";
        }


        // Affichage des samples détectés (comme editrun)
        async function checkSampleSheet(filename) {
            const formData = new FormData();
            formData.append('file_name', filename);
            const response = await fetch('/mercure/api/samplesheet/check', {
                method: 'POST',
                body: formData
            });
            const result = await response.json();
            try {
                if (result.success) {
                    return result.data;
                } else {
                    throw new Error(result.message);
                }
            }
            catch (e) {
                return { file_name: filename, sample_names: [], unique_sample_count: 0, message: "Erreur lors de la vérification de la samplesheet: " + e.message };
            }
        }

        document.addEventListener('DOMContentLoaded', async function () {
            // ADN
            const adnPath = document.getElementById('sample_sheet_adn_path') ? document.getElementById('sample_sheet_adn_path').value : '';
            if (adnPath) {
                const { file_name, sample_names, message, unique_sample_count } = await checkSampleSheet(adnPath);
                document.getElementById('sample_sheet_adn_check').innerHTML = message;
                if (sample_names) {
                    const container = document.getElementById('sample_sheet_adn_list');
                    container.innerHTML = "";
                    createFormattedList(sample_names, container, `Echantillons ADN détectés (${unique_sample_count} uniques)`);
                }
            }
            // ARN
            const arnPath = document.getElementById('sample_sheet_arn_path') ? document.getElementById('sample_sheet_arn_path').value : '';
            if (arnPath) {
                const { file_name, sample_names, message, unique_sample_count } = await checkSampleSheet(arnPath);
                document.getElementById('sample_sheet_arn_check').innerHTML = message;
                if (sample_names) {
                    const container = document.getElementById('sample_sheet_arn_list');
                    container.innerHTML = "";
                    createFormattedList(sample_names, container, `Echantillons ARN détectés (${unique_sample_count} uniques)`);
                }
            }
            // Affichage des variables utilisateur (readonly)
            const userDefinedVars = JSON.parse({{ user_defined_vars_json | tojson }});
        const currentUserDefinedVars = {{ run.user_defined_vars | tojson }};
        const container = document.getElementById('user-defined-vars');
        const advancedContainer = document.getElementById('user-defined-vars-advanced');
        let hasAdvancedVars = false;

        for (const [key, value] of Object.entries(userDefinedVars).sort()) {
            const isConstant = value && typeof value === 'object' && 'Constant' in value;

            const div = document.createElement('div');
            const label = document.createElement('label');
            label.innerHTML = `<strong>${key}</strong>: `;
            div.appendChild(label);
            div.appendChild(document.createTextNode(' '));
            const span = document.createElement('span');
            span.textContent = currentUserDefinedVars[key] || '';
            div.appendChild(span);

            if (isConstant) {
                advancedContainer.appendChild(div);
                hasAdvancedVars = true;
            } else {
                container.appendChild(div);
            }

        }

        if (hasAdvancedVars) {
            const toggleBtn = document.getElementById('toggle-advanced-btn');
            const advancedDiv = document.getElementById('advanced-vars-container');
            toggleBtn.style.display = 'inline-block';

            toggleBtn.addEventListener('click', function () {
                if (advancedDiv.style.display === 'none') {
                    advancedDiv.style.display = 'block';
                    toggleBtn.textContent = 'Masquer les paramètres avancés';
                } else {
                    advancedDiv.style.display = 'none';
                    toggleBtn.textContent = 'Afficher les paramètres avancés';
                }
            });
        }

        // Correction de l'affichage du séquenceur
        const seqnameDiv = document.getElementById('seq-name');
        const seqname = seqnameDiv.textContent;
        try {
            const resp = await fetch(`/mercure/api/prettify/seqname/${encodeURIComponent(seqname)}`);
            if (resp.ok) {
                const data = await resp.text();
                seqnameDiv.textContent = data;
            }
        } catch (e) {
            // Pas gênant, dans tous les cas c'est le nom du dossier qui s'affichera
        }


        });

        // Bouton valider (même logique que editrun)
        document.getElementById('validate-btn').addEventListener('click', async function () {
            const runId = "{{ run_id }}";
            if (!runId) {
                showMessage("error", "ID du run introuvable dans l'URL.");
                return;
            }
            if (confirm("Êtes-vous sûr de vouloir valider ce run ? L'analyse sera lancée dès que le run sera terminé.")) {
                try {
                    const response = await fetch('/mercure/api/validate/' + runId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                    const data = await response.json();
                    if (data.success) {
                        window.location = "/mercure/api/redirect?target_url=/mercure/show/run/{{ run_id }}" +
                            "&title=" + encodeURIComponent("Succès") +
                            "&message=" + encodeURIComponent(data.data.message) +
                            "&seconds=5";
                    } else {
                        showMessage("error", data.message);
                    }
                } catch (error) {
                    showMessage("error", "Erreur lors de la validation: " + error);
                }
            }
        });
    </script>
</body>

</html>