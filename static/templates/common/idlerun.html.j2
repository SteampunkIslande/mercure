{% extends "common/run_base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Run à valider | {{ run.run_name }}{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Analyse · à valider</p>
    <h1>{{ run.run_name }}</h1>
    <p>{{ form.name }}</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/show/runs">{{ ui.icon("chart") }}Mes analyses</a>
    <a class="btn btn-secondary" href="/smaug/editrun/{{ run.run_id }}">{{ ui.icon("sliders") }}Modifier</a>
    <button type="button" class="btn" data-run-action="validate">{{ ui.icon("check") }}Valider</button>
  </div>
</header>

{% include "common/runinfo.html.j2" %}
{% endblock %}
