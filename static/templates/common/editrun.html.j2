{% extends "base.html.j2" %}


{% block title %}{%- if run %}Editer un run{% else %}Nouveau Run{% endif %}{% endblock %}

{% block banner_text %}
{% if run %}Editer le run {{ run.run_name }}
{% else %}Nouveau Run
{% endif %}
<br><span class="banner-text">{{ form.name }}{% if form.branch %} (sur la branche {{ form.branch }}){% endif %}</span>
{%endblock %}

{% block body_attrs %}
onload="init()"
{% endblock %}

{% block content %}
<h2>{% if run %}Edition du run {{ run.run_name }}{% else %}Déclarer un nouveau run{% endif %}</h2>

<form id="{% if run %}editrun-form{% else %}newrun-form{% endif %}" class="form-vertical" style="margin: 1em auto;">

    {% if run %}
    <input type="hidden" id="run_id" value="{{ run.run_id }}">
    {% endif %}

    <div>
        <label for="run_name">Nom du run:</label>
        {% if run %}
        <span id="run_name" style="font-weight: bold;">{{ run.run_name }}</span>
        {% else %}
        <input type="text" id="run_name" required>
        {% endif %}
    </div>

    {% if form.description %}
    <p>{{ form.description }}</p>
    {% endif %}

    <h3>Variables du formulaire</h3>
    <div id="form-variables">
        {% for var in user_defined_vars %}
        {{ var | safe }}
        {% endfor %}
    </div>

    <div style="text-align: left; margin-top: 20px;">
        {% if run %}
        <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/run/{{ run.run_id }}">Retour</a>
        <a id="save-changes" onclick="handleSubmit()" class="btn btn-primary">Enregistrer les modifications</a>
        {% else %}
        <a class="btn btn-secondary" href="/mercure/home">Retour</a>
        <a class="btn btn-primary" onclick="handleSubmit()">Soumettre</a>
        {% endif %}
    </div>
</form>
{% endblock %}

{% block extra_js %}
<script>
    const form = {{ form | tojson }};
    const currentUser = {{ user | tojson }};
    {% if run %}
    const currentRun = {{ run | tojson }};
    {% else %}
    const currentRun = null;
    {% endif %}

    // Run initialization as soon as the DOM is ready
    document.addEventListener('DOMContentLoaded', init);

    async function init() {
        const dynamicSelects = document.querySelectorAll('select[data-source]');
        const fetchPromises = [];

        // 1. Fetch and initialize all URL-based lists concurrently
        dynamicSelects.forEach(select => {
            const url = select.dataset.source;
            const varname = select.id;
            let currentValue = null;

            // Check if we are editing an existing run and have a saved value for this field
            if (currentRun && currentRun.user_defined_vars) {
                // Adjust if your user_defined_vars structure is an array instead of an object map
                currentValue = currentRun.user_defined_vars[varname];
            }

            fetchPromises.push(initListVarFromURL(select, url, currentValue));
        });

        await Promise.all(fetchPromises);

        // 2. Pre-fill standard text, date, and static list inputs (if editing a run)
        if (currentRun && currentRun.user_defined_vars) {
            for (const [key, value] of Object.entries(currentRun.user_defined_vars)) {
                const input = document.getElementById(key);
                // Skip the dynamic selects since we just handled them asynchronously
                if (input && !input.hasAttribute('data-source')) {
                    input.value = value;
                }
            }
        }
    }

    async function initListVarFromURL(selectElement, url, currentValue) {
        try {

            selectElement.innerHTML = '<option value="" disabled selected>Chargement...</option>';

            const response = await fetch(url);
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const data = await response.json();
            selectElement.innerHTML = ''; // Clear the loading state

            // Populate options. Handles both flat strings arrays ["A", "B"] 
            // and object arrays [{value: "A", label: "Alpha"}]
            data.forEach(item => {
                const opt = document.createElement('option');
                if (typeof item === 'object' && item !== null) {
                    opt.value = item.value || item.id || item.name;
                    opt.text = item.label || item.name || item.value;
                } else {
                    opt.value = item;
                    opt.text = item;
                }
                selectElement.appendChild(opt);
            });

            // Select the previously saved value if we are editing
            if (currentValue !== null && currentValue !== undefined) {
                selectElement.value = currentValue;
            }

        } catch (error) {
            console.error(`Erreur de chargement pour ${selectElement.id}:`, error);
            selectElement.innerHTML = '<option value="" disabled>Erreur de chargement</option>';
        }
    }

    function collectFormVariables() {
        const variables = {};
        const container = document.getElementById('form-variables');

        if (!container) {
            return variables;
        }

        // Grab all standard inputs and selects generated by your Rust code
        const elements = container.querySelectorAll('input, select');

        elements.forEach(el => {
            // Use the 'name' attribute (falling back to 'id' just in case)
            const key = el.name || el.id;
            if (!key) return;

            // Handle different input types
            if (el.type === 'file') {
                // For file inputs, browsers prefix the value with "C:\fakepath\" for security.
                // Grabbing the actual file name from the files array is usually cleaner.
                if (el.files && el.files.length > 0) {
                    variables[key] = el.files[0].name;
                } else {
                    variables[key] = "";
                }
            } else {
                // For text, date, and select elements, .value works perfectly
                variables[key] = el.value;
            }
        });

        return variables;
    }

    async function handleSubmit() {
        // Assume missingFormVariables and collectFormVariables are defined elsewhere in your JS

        const userDefinedVars = collectFormVariables();

        try {
            {% if run %}
            const payload = {
                ...currentRun,
                user_defined_vars: userDefinedVars
            };
            const endpoint = '/mercure/api/editrun';
            {% else %}
            const run_name = document.getElementById('run_name').value;
            if (!run_name) {
                showMessage("error", "Le nom du run est obligatoire.");
                return;
            }
            if (!form.file_path || !form.branch) {
                showMessage("error", "Formulaire incomplet: branche ou fichier manquant.");
                return;
            }
            const payload = {
                user_id: currentUser.id,
                run_name: run_name,
                user_defined_vars: userDefinedVars,
                form_path: form.file_path,
                branch_name: form.branch,
                creation_date: "",
                status: "Idle",
                attempt_count: 0
            };
            const endpoint = '/mercure/api/newrun';
            {% endif %}

            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });
            const data = await response.json();
            if (response.status !== 200) {
                throw new Error(response.statusText || 'Erreur lors de la sauvegarde du run.');
            }

            // Assume isApiSuccess, getApiData, and getApiMessage are defined globally
            if (isApiSuccess(data)) {
                {% if run %}
                let new_url = "/mercure/api/redirect?target_url=/mercure/show/run/{{ run.run_id }}";
                {% else %}
                let new_url = "/mercure/api/redirect?target_url=/mercure/show/run/" + getApiData(data).run_id;
                {% endif %}
                new_url += "&title=" + encodeURIComponent("Succès") +
                    "&message=" + encodeURIComponent(getApiData(data).message) +
                    "&seconds=5";
                window.location.href = new_url;
            } else {
                showMessage("error", getApiMessage(data));
            }
        } catch (error) {
            showMessage("error", error);
        }
    }
</script>
{% endblock %}