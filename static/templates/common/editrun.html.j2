<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editer un run</title>
    <link rel="stylesheet" type="text/css" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <script src="/static/scripts/utils.js"></script>
    <script src="/static/scripts/json_list.js"></script>
    <script src="/static/scripts/show_message.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Editer un run - {{ user.username }}</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>



    <h2>Edition du run</h2>

    <form id="editrun-form">
        <style>
            #editrun-form div {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                margin-bottom: 10px;
            }

            #editrun-form label {
                margin-bottom: 5px;
                text-align: left;
            }

            #editrun-form input {
                width: 33.3%;
            }
        </style>

        <input type="hidden" id="run_id" value="{{ run_id }}">

        <div>
            <label for="run_name">Nom du run:</label>
            <span id="run_name" style="font-weight: bold;">{{ run.run_name }}</span>
            <input type="hidden" id="run_name" value="{{ run.run_name }}">
        </div>

        <div>
            <label for="run_date">Date du run:</label>
            <input type="date" id="run_date" value="{{ run.run_date }}" required>
        </div>

        <div>
            <label for="run_sequencer">Séquenceur:</label>
            <select id="run_sequencer" required>
                {% for seq in sequenceurs_list %}
                <option value="{{ seq }}" {% if seq==run.run_sequencer %}selected{% endif %}>{{ seq }}</option>
                {% endfor %}
            </select>
        </div>

        <div>
            <label for="run_flowcellid">Flowcell ID:</label>
            <input type="text" id="run_flowcellid" value="{{ run.run_flowcellid }}" required>
        </div>

        <div class="tab">
            <button id="tab-adn" class="tablinks active" onclick="openFilesTab(event,`adn`)">ADN</button>
            <button id="tab-arn" class="tablinks" onclick="openFilesTab(event,`arn`)">ARN</button>
            <button id="tab-metadata" class="tablinks" onclick="openFilesTab(event,`metadata`)">Metadata</button>
        </div>

        <div class="tabcontent" id="tabcontent-adn" style="display:block">
            <label for="sample_sheet_adn_file">Modifier sample sheet ADN:</label>
            <input type="file" id="sample_sheet_adn_file">
            <input type="hidden" id="sample_sheet_adn_path" value="{{ run.sample_sheet_adn_path }}">
            <div id="sample_sheet_adn_check"></div>
            <div id="sample_sheet_adn_list" class="sample-list"></div>
        </div>

        <div class="tabcontent" id="tabcontent-arn" style="display:none">
            <label for="sample_sheet_arn_file">Modifier sample sheet ARN:</label>
            <input type="file" id="sample_sheet_arn_file">
            <input type="hidden" id="sample_sheet_arn_path" value="{{ run.sample_sheet_arn_path }}">
            <div id="sample_sheet_arn_check"></div>
            <div id="sample_sheet_arn_list" class="sample-list"></div>
        </div>

        <div class="tabcontent" id="tabcontent-metadata" style="display:none">
            <label for="metadata_file">Modifier metadata:</label>
            <input type="file" id="metadata_file">
            <input type="hidden" id="metadata_path" value="{{ run.metadata_path }}">
        </div>


        <h3>Variables définies par l'utilisateur</h3>
        <div id="user-defined-vars"></div>

        <button id="save-changes" type="submit" class="btn">Enregistrer les modifications</button>
        <button type="button" id="validate-btn" class="btn" style="margin-left: 10px;">Valider le
            run</button>
        <div style="text-align: center; margin-top: 20px;">
            <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/runs">Retour</a>
        </div>
    </form>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>

    <script>
        // Exemple: {"BED_PATH":{"Constant":"/reference/bed/pneumo"},"RUN_NAME":"RunDefined","BED":{"FromValuesList":{"allowed":["pneumo_v6","pneumo_v7","pneumo_v8"]}}}
        const userDefinedVars = JSON.parse({{ user_defined_vars_json | tojson }});

        // Generate user-defined fields
        const container = document.getElementById('user-defined-vars');
        for (const [key, value] of Object.entries(userDefinedVars)) {
            if (typeof value === 'object' && value.Constant) {
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.id = 'udv_' + key;
                hidden.value = value.Constant;
                container.appendChild(hidden);
            } else if (typeof value === 'object' && value.FromValuesList) {
                const div = document.createElement('div');
                const label = document.createElement('label');
                label.for = 'udv_' + key;
                label.textContent = key + ':';
                div.appendChild(label);
                const select = document.createElement('select');
                select.id = 'udv_' + key;
                value.FromValuesList.allowed.forEach(val => {
                    const option = document.createElement('option');
                    option.value = val;
                    option.textContent = val;
                    select.appendChild(option);
                });
                div.appendChild(select);
                container.appendChild(div);
            } else if (value === 'RunDefined') {
                const div = document.createElement('div');
                const label = document.createElement('label');
                label.for = 'udv_' + key;
                label.textContent = key + ':';
                div.appendChild(label);
                const input = document.createElement('input');
                input.type = 'text';
                input.id = 'udv_' + key;
                div.appendChild(input);
                container.appendChild(div);
            }
        }

        // Populate user-defined variables with current values
        const currentUserDefinedVars = {{ run.user_defined_vars | tojson }};
        for (const [key, value] of Object.entries(currentUserDefinedVars)) {
            const element = document.getElementById('udv_' + key);
            if (element) {
                element.value = value;
            }
        }

        // Function to upload file
        async function uploadFile(file) {
            const formData = new FormData();
            formData.append('file', file);
            formData.append('file_name_base', file.name);

            const response = await fetch('/mercure/api/upload', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            if (result.success) {
                return result.data;
            } else {
                throw new Error(result.message);
            }
        }
        // Function to check sample sheet
        async function checkSampleSheet(filename) {
            const formData = new FormData();
            formData.append('file_name', filename);

            const response = await fetch('/mercure/api/samplesheet/check', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            if (result.success) {
                return result.data;
            } else {
                throw new Error(result.message);
            }
        }

        // Tabs initialization for file-type panels (use same classes as home.html)
        function openFilesTab(evt, tabName) {
            // Prevent default button behavior (avoids submitting the form)
            evt.preventDefault();

            // Declare all variables
            var i, tabcontent, tablinks;

            // Get all elements with class="tabcontent" and hide them
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            // Get all elements with class="tablinks" and remove the class "active"
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }

            // Show the current tab, and add an "active" class to the button that opened the tab
            document.getElementById(`tabcontent-${tabName}`).style.display = "block";
            evt.currentTarget.className += " active";
        }

        // on upload: show check message AND sample list when available
        document.getElementById('sample_sheet_adn_file').addEventListener('change', async function () {
            if (this.files.length > 0) {
                try {
                    const upload_path = await uploadFile(this.files[0]);
                    const { file_name, sample_names, message } = await checkSampleSheet(upload_path);
                    document.getElementById('sample_sheet_adn_path').value = file_name;
                    document.getElementById('sample_sheet_adn_check').innerHTML = message;
                    if (sample_names) {
                        const container = document.getElementById('sample_sheet_adn_list');
                        createFormattedList(sample_names, container, "Echantillons ADN détectés");
                    }
                } catch (error) {
                    alert('Erreur upload ADN: ' + error.message);
                }
            }
        });

        document.getElementById('sample_sheet_arn_file').addEventListener('change', async function () {
            if (this.files.length > 0) {
                try {
                    const upload_path = await uploadFile(this.files[0]);
                    const { file_name, sample_names, message } = await checkSampleSheet(upload_path);
                    document.getElementById('sample_sheet_arn_path').value = file_name;
                    document.getElementById('sample_sheet_arn_check').innerHTML = message;
                    if (sample_names) {
                        const container = document.getElementById('sample_sheet_arn_list');
                        createFormattedList(sample_names, container, "Echantillons ARN détectés");
                    }
                } catch (error) {
                    alert('Erreur upload ARN: ' + error.message);
                }
            }
        });

        document.getElementById('metadata_file').addEventListener('change', async function () {
            if (this.files.length > 0) {
                try {
                    const path = await uploadFile(this.files[0]);
                    document.getElementById('metadata_path').value = path;
                } catch (error) {
                    alert('Erreur upload metadata: ' + error.message);
                }
            }
        });

        // On page load: if a samplesheet path is already present, fetch and display sample names
        document.addEventListener('DOMContentLoaded', async function () {
            const adnPath = document.getElementById('sample_sheet_adn_path') ? document.getElementById('sample_sheet_adn_path').value : '';
            const arnPath = document.getElementById('sample_sheet_arn_path') ? document.getElementById('sample_sheet_arn_path').value : '';
            if (adnPath) {
                const { file_name, sample_names, message } = await checkSampleSheet(adnPath);
                document.getElementById('sample_sheet_adn_path').value = file_name;
                document.getElementById('sample_sheet_adn_check').innerHTML = message;
                if (sample_names) {
                    const container = document.getElementById('sample_sheet_adn_list');
                    container.innerHTML = "";
                    createFormattedList(sample_names, container, "Echantillons ADN détectés");
                }
            }
            if (arnPath) {
                const { file_name, sample_names, message } = await checkSampleSheet(arnPath);
                document.getElementById('sample_sheet_arn_path').value = file_name;
                document.getElementById('sample_sheet_arn_check').innerHTML = message;
                if (sample_names) {
                    const container = document.getElementById('sample_sheet_arn_list');
                    container.innerHTML = "";
                    createFormattedList(sample_names, container, "Echantillons ARN détectés");
                }
            }
        });

        document.getElementById('editrun-form').addEventListener('submit', function (event) {
            event.preventDefault();

            // Collect user_defined_vars
            const userDefinedVars = {};
            const udvElements = document.querySelectorAll('[id^="udv_"]');
            udvElements.forEach(el => {
                if (el.tagName === 'INPUT' || el.tagName === 'SELECT') {
                    const key = el.id.replace('udv_', '');
                    userDefinedVars[key] = el.value;
                }
            });

            const formData = {
                run_id: parseInt(document.getElementById('run_id').value),

                run_date: document.getElementById('run_date').value,
                run_sequencer: document.getElementById('run_sequencer').value,
                run_flowcellid: document.getElementById('run_flowcellid').value,

                sample_sheet_adn_path: document.getElementById('sample_sheet_adn_path').value,
                sample_sheet_arn_path: document.getElementById('sample_sheet_arn_path').value,
                metadata_path: document.getElementById('metadata_path').value,

                user_defined_vars: userDefinedVars
            };

            fetch('/mercure/api/editrun/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            })
                .then(response => response.json())
                .then(data => {
                    const messageDiv = document.getElementById('message');
                    if (data.success) {
                        showMessage("info", data.data.message);
                    } else {
                        showMessage("error", data.message);
                    }
                })
                .catch(error => {
                    showMessage("error", error);
                });
        });

        // Handle validate button click
        document.getElementById('validate-btn').addEventListener('click', function () {
            if (confirm("Êtes-vous sûr de vouloir valider ce run ? L'analyse sera lancée dès que le run sera terminé.")) {
                fetch('/mercure/api/validate/' + document.getElementById('run_id').value, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showMessage("success", "Run validé avec succès !");
                            setTimeout(() => {
                                // Comme une redirection, mais comme c'est la même URL que l'actuelle (normalement), agit comme un rafraîchissement de la page
                                window.location.href = "/mercure/show/run/" + document.getElementById('run_id').value;
                            }, 1000);
                        } else {
                            showMessage("error", data.message);
                        }
                    })
                    .catch(error => {
                        showMessage("error", "Erreur lors de la validation: " + error);
                    });
            }
        });

    </script>
</body>

</html>