{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}{% if run %}Modifier un run{% else %}Nouveau run{% endif %} | SMAUG{% endblock %}
{% block body_class %}run-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">{% if run %}Édition{% else %}Nouvelle analyse{% endif %}</p>
    <h1>{% if run %}Modifier le run{% else %}Déclarer un nouveau run{% endif %}</h1>
    <p>{{ form.name }}{% if form.branch %} · branche {{ form.branch }}{% endif %}</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="{% if run %}/smaug/show/run/{{ run.run_id }}{% else %}/smaug/home{% endif %}">{{ ui.icon("arrow-left") }}Retour</a>
  </div>
</header>

<div class="grid-2">
  <section class="panel" aria-labelledby="form-title">
    <div class="panel-title">
      <div>{{ ui.icon("flask", "section-icon") }}<h2 id="form-title">Paramètres</h2></div>
    </div>

    <form id="run-form" class="form">
      <div class="field">
        <label for="run-name">Nom du run</label>
        {% if run %}
        <input id="run-name" type="text" value="{{ run.run_name }}" readonly>
        {% else %}
        <input id="run-name" type="text" name="run_name" placeholder="Ex. analyse-2026-001" required>
        {% endif %}
      </div>

      {% if form.description %}
      <p class="field-help">{{ form.description }}</p>
      {% endif %}

      {% if warning %}
      <p class="alert alert--warning">{{ warning }}</p>
      {% endif %}

      <h2>Variables du formulaire</h2>
      <div id="form-variables" class="variables" aria-live="polite">
        <p class="empty-state">Chargement des variables…</p>
      </div>

      <div class="form-actions">
        <button id="save-run" class="btn" type="submit">{{ ui.icon("save") }}{% if run %}Enregistrer les modifications{% else %}Soumettre le run{% endif %}</button>
        <a class="btn btn-secondary" href="{% if run %}/smaug/show/run/{{ run.run_id }}{% else %}/smaug/home{% endif %}">Annuler</a>
      </div>
    </form>
  </section>

  <aside class="panel">
    <div class="panel-title">
      <div>{{ ui.icon("info", "section-icon") }}<h2>Résumé</h2></div>
    </div>
    <dl class="run-meta">
      <div class="info-row"><dt>Formulaire</dt><dd>{{ form.name }}</dd></div>
      <div class="info-row"><dt>Branche</dt><dd>{{ form.branch | default("—") }}</dd></div>
      <div class="info-row"><dt>Fichier</dt><dd>{{ form.file_path | default("—") }}</dd></div>
      <div class="info-row"><dt>Exécution</dt><dd>{{ form.exec | default(form.script_name | default("—")) }}</dd></div>
    </dl>
    <p class="panel-footnote">Les variables marquées comme fichier sont envoyées sur le serveur au moment de leur sélection.</p>
  </aside>
</div>

<script type="application/json" id="page-data">
{% if run %}{{ {"form": form, "user": user, "run": run} | tojson }}{% else %}{{ {"form": form, "user": user, "run": null} | tojson }}{% endif %}
</script>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/editrun.js"></script>
{% endblock %}
