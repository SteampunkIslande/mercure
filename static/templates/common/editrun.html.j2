<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if run %}Editer un run{% else %}Nouveau Run{% endif %}</title>
    <link rel="stylesheet" type="text/css" href="/mercure/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/mercure/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/mercure/static/favicon.ico" />

    <script src="/mercure/static/scripts/show_message.js"></script>
    <script src="/mercure/static/scripts/form_variables.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">{% if run %}Editer un run{% else %}Nouveau Run{% endif %}<br>
                <span class="banner-text">Pipeline: {{ form.name }}{% if form.branch %} (branche {{ form.branch
                    }}{% if form.file_path %}, {{ form.file_path }}{% endif %}){% endif %}</span></span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>

    <h2>{% if run %}Edition du run{% else %}Déclarer un nouveau run{% endif %}</h2>

    <form id="{% if run %}editrun-form{% else %}newrun-form{% endif %}" class="form-vertical" style="margin: 1em auto;">

        <input type="hidden" id="run_id" value="{{ run_id }}">

        <div>
            <label for="run_name">Nom du run:</label>
            {% if run %}
            <span id="run_name" style="font-weight: bold;">{{ run.run_name }}</span>
            {% else %}
            <input type="text" id="run_name" required>
            {% endif %}
        </div>

        <h3>Variables du formulaire</h3>
        <div id="form-variables"></div>

        <div style="text-align: left; margin-top: 20px;">
            {% if run %}
            <a id="back-to-runs" class="btn btn-secondary" href="/mercure/show/run/{{ run_id }}">Retour</a>
            <a id="save-changes" onclick="handleSubmit()" class="btn btn-primary">Enregistrer les modifications</a>
            {% else %}
            <a class="btn btn-secondary" href="/mercure/home">Retour</a>
            <a class="btn btn-primary" onclick="handleSubmit()">Soumettre</a>
            {% endif %}
        </div>
    </form>

    <script>
        // Le formulaire est fourni tel quel par la route : le rendu des variables
        // est entièrement à la charge de la page (cf. form_variables.js).
        const formSchema = {{ form | tojson }};
        const currentUser = {{ user | tojson }};
        {% if run %}
        const currentRun = {{ run | tojson }};
        {% else %}
        const currentRun = null;
        {% endif %}

        document.addEventListener('DOMContentLoaded', async function () {
            await renderFormVariables(formSchema, currentRun ? currentRun.user_defined_vars : {});
        });

        async function handleSubmit() {
            const missing = missingFormVariables();
            if (missing.length > 0) {
                showMessage("error", "Valeur(s) manquante(s) pour : " + missing.join(", "));
                return;
            }
            const userDefinedVars = collectFormVariables();

            try {
                {% if run %}
                const payload = {
                    run_id: parseInt(document.getElementById('run_id').value),
                    user_defined_vars: userDefinedVars
                };
                const endpoint = '/mercure/api/editrun';
                {% else %}
                const run_name = document.getElementById('run_name').value;
                if (!run_name) {
                    showMessage("error", "Le nom du run est obligatoire.");
                    return;
                }
                const payload = {
                    user_id: currentUser.id,
                    run_name: run_name,
                    user_defined_vars: userDefinedVars,
                    form_path: formSchema.file_path,
                    branch_name: formSchema.branch
                };
                const endpoint = '/mercure/api/newrun';
                {% endif %}

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (response.status !== 200) {
                    throw new Error(response.statusText || 'Erreur lors de la sauvegarde du run.');
                }
                if (isApiSuccess(data)) {
                    {% if run %}
                    let new_url = "/mercure/api/redirect?target_url=/mercure/show/run/{{ run_id }}";
                    {% else %}
                    let new_url = "/mercure/api/redirect?target_url=/mercure/show/run/" + getApiData(data).run_id;
                    {% endif %}
                    new_url += "&title=" + encodeURIComponent("Succès") +
                        "&message=" + encodeURIComponent(getApiData(data).message) +
                        "&seconds=5";
                    window.location.href = new_url;
                } else {
                    showMessage("error", getApiMessage(data));
                }
            } catch (error) {
                showMessage("error", error);
            }
        }
    </script>
</body>

</html>
