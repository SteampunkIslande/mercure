<div>
    <link rel="stylesheet" type="text/css" href="/smaug/static/styles/default-squeue.css">
    <div class="container">

        <div id="error-container"></div>

        <div id="controls-bar" class="controls-bar">
            <div class="field-selector">
                <label for="field-preset">Sélection de champs :</label>
                <select id="field-preset" onchange="applyFieldPreset()">
                    <option value="">Tous les champs</option>
                    <!-- Options will be added dynamically from field_presets.json -->
                </select>
            </div>
            <div class="refresh-controls">
                <button id="refresh-btn" onclick="pollJobInfo()">🔄 Actualiser</button>
            </div>
        </div>

        <div id="slurm-table-container" class="table-container">
            <div id="loading" class="loading">Chargement des données</div>

            <table id="squeue-table" style="display: none;">
                <thead>
                    <tr id="headers-row">
                        <!-- Headers will be dynamically generated -->
                    </tr>
                    <tr class="filters-row" id="filters-row">
                        <!-- Search inputs will be dynamically generated -->
                    </tr>
                </thead>
                <tbody id="table-body">
                    <!-- Data rows will be dynamically generated -->
                </tbody>
            </table>

            <div id="no-results" class="no-results" style="display: none;">
                Aucun job ne correspond aux critères de recherche.
            </div>
        </div>
    </div>

    <script>
        // Configuration and global variables
        let jobsData = {};
        let filteredData = {};
        let columnNames = [];
        let visibleColumns = []; // Currently visible columns
        let allColumns = []; // All available columns
        let fieldPresets = {}; // Field presets loaded from the JSON

        // Function to display errors
        function showError(message) {
            const errorContainer = document.getElementById('error-container');
            errorContainer.innerHTML = `<div class="error-message">${message}</div>`;
        }

        // Function to hide loading and display the table
        function hideLoading() {
            document.getElementById('loading').style.display = 'none';
            document.getElementById('squeue-table').style.display = 'table';
        }

        function showLoading() {
            document.getElementById('loading').style.display = 'block';
            document.getElementById('squeue-table').style.display = 'none';
        }

        // Function to get a CSS class for the state
        function getStatusClass(state) {
            const stateUpper = state.toUpperCase();
            switch (stateUpper) {
                case 'RUNNING':
                case 'R':
                    return 'status-running';
                case 'PENDING':
                case 'PD':
                    return 'status-pending';
                case 'FAILED':
                case 'F':
                    return 'status-failed';
                case 'CANCELLED':
                case 'CA':
                    return 'status-cancelled';
                case 'COMPLETED':
                case 'CD':
                    return 'status-completed';
                case 'TIMEOUT':
                case 'TO':
                    return 'status-timeout';
                case 'SUSPENDED':
                case 'S':
                    return 'status-suspended';
                case 'CONFIGURING':
                case 'CF':
                    return 'status-configuring';
                default:
                    return '';
            }
        }

        // Function to get a CSS class for the QOS
        function getQosClass(qos) {
            const qosLower = qos.toLowerCase();
            switch (qosLower) {
                case 'urgent':
                    return 'qos-urgent';
                case 'routine':
                    return 'qos-routine';
                case 'recherche':
                    return 'qos-recherche';
                case 'dev':
                    return 'qos-dev';
                default:
                    return '';
            }
        }

        // Function to format a cell value
        function formatCellValue(columnName, value) {
            if (columnName === 'STATE') {
                const statusClass = getStatusClass(value);
                return `<span class="status-badge ${statusClass}">${value}</span>`;
            } else if (columnName === 'QOS') {
                const qosClass = getQosClass(value);
                return `<span class="qos-badge ${qosClass}">${value}</span>`;
            }
            return value;
        }

        // Function to load field presets from the JSON
        async function loadFieldPresets() {
            try {
                const response = await fetch('/squeue/smaug/static/field_presets.json');
                if (!response.ok) {
                    throw new Error(`Erreur HTTP: ${response.status}`);
                }
                fieldPresets = await response.json();
                populatePresetSelect();
            } catch (error) {
                console.error('Erreur lors du chargement des presets:', error);
                // Use a default preset if the file cannot be loaded
                fieldPresets = {
                    "__default__": {
                        "name": "Surveillance administrateur",
                        "fields": [
                            "JOBID",
                            "STATE",
                            "QOS",
                            "TIME",
                            "CPUS",
                            "MIN_MEMORY",
                            "COMMENT",
                            "ACCOUNT",
                            "NODELIST",
                            "TRES_PER_NODE"
                        ]
                    }
                };
                populatePresetSelect();
            }
        }

        // Function to populate the preset dropdown
        function populatePresetSelect() {
            const selectElement = document.getElementById('field-preset');

            // Keep the "All fields" option
            selectElement.innerHTML = '<option value="">Tous les champs</option>';

            // Add the presets from the JSON
            Object.keys(fieldPresets).forEach(presetKey => {
                const preset = fieldPresets[presetKey];
                const option = document.createElement('option');
                option.value = presetKey;
                option.textContent = preset.name || presetKey.replace('_', ' ');
                selectElement.appendChild(option);
            });

            // Select the __default__ preset if it exists
            if (fieldPresets['__default__']) {
                selectElement.value = '__default__';
            }
        }

        // Function to load data from the API
        async function loadData(slurm_jobname) {
            try {

                // Display a loading message
                showLoading();
                const jobname_option = slurm_jobname ? `&jobname=${slurm_jobname}` : "";
                const response = await fetch(`/squeue?format=json${jobname_option}`);
                if (!response.ok) {
                    throw new Error(`Erreur HTTP: ${response.status}`);
                }

                const data = await response.json();
                jobsData = data;
                filteredData = { ...data };

                // Extract the column names from the first job
                const firstJobId = Object.keys(data)[0];
                if (firstJobId) {
                    allColumns = Object.keys(data[firstJobId]);
                    columnNames = [...allColumns]; // By default, all columns are visible
                    visibleColumns = [...allColumns];
                    generateTable();
                    hideLoading();
                } else {
                    showNoResults();
                    hideLoading();
                }
            } catch (error) {
                console.error('Erreur lors du chargement des données:', error);
                showError(`Erreur lors du chargement des données: ${error.message}`);
                hideLoading();
            }
        }

        // Function to generate the table headers and filters
        function generateTable() {
            const headersRow = document.getElementById('headers-row');
            const filtersRow = document.getElementById('filters-row');

            // Generate the headers with the visible columns
            headersRow.innerHTML = visibleColumns.map(col => `<th>${col}</th>`).join('');

            // Generate the filters with the visible columns
            filtersRow.innerHTML = visibleColumns.map(col =>
                `<th><input type="text" class="search-input" placeholder="Rechercher..." data-column="${col}" oninput="filterTable()"></th>`
            ).join('');

            // Generate the table content
            renderTableBody();
        }

        // Function to render the table body
        function renderTableBody() {
            const tableBody = document.getElementById('table-body');
            const noResults = document.getElementById('no-results');

            const jobIds = Object.keys(filteredData);

            if (jobIds.length === 0) {
                showNoResults();
                return;
            }

            hideNoResults();

            tableBody.innerHTML = jobIds.map(jobId => {
                const job = filteredData[jobId];
                const cells = visibleColumns.map(col =>
                    `<td>${formatCellValue(col, job[col] || '')}</td>`
                ).join('');
                return `<tr>${cells}</tr>`;
            }).join('');
        }

        // Function to display the "no results" message
        function showNoResults() {
            document.getElementById('no-results').style.display = 'block';
            document.getElementById('table-body').innerHTML = '';
        }

        // Function to hide the "no results" message
        function hideNoResults() {
            document.getElementById('no-results').style.display = 'none';
        }

        // Function to apply a field preset
        function applyFieldPreset() {
            const preset = document.getElementById('field-preset').value;

            if (preset === '') {
                // Display all columns
                visibleColumns = [...allColumns];
            } else {
                // Use the preset fields from the JSON
                if (fieldPresets[preset] && fieldPresets[preset].fields) {
                    visibleColumns = fieldPresets[preset].fields.filter(col => allColumns.includes(col));
                } else if (fieldPresets[preset] && Array.isArray(fieldPresets[preset])) {
                    // Fallback for the old schema (direct array)
                    visibleColumns = fieldPresets[preset].filter(col => allColumns.includes(col));
                } else {
                    // Fallback for the old system (comma split)
                    visibleColumns = preset.split(',');
                }
            }

            // Regenerate the table with the new columns
            generateTable();
        }

        // Function for table filtering
        function filterTable() {
            const filters = {};

            // Retrieve all active filters
            document.querySelectorAll('.search-input').forEach(input => {
                const column = input.dataset.column;
                const value = input.value.toLowerCase().trim();
                if (value) {
                    filters[column] = value;
                }
            });

            // Filter the data
            filteredData = {};
            Object.keys(jobsData).forEach(jobId => {
                const job = jobsData[jobId];
                let matchesAllFilters = true;

                // Check each filter
                Object.keys(filters).forEach(column => {
                    const filterValue = filters[column];
                    const cellValue = (job[column] || '').toLowerCase();

                    if (!cellValue.includes(filterValue)) {
                        matchesAllFilters = false;
                    }
                });

                if (matchesAllFilters) {
                    filteredData[jobId] = job;
                }
            });

            // Re-render the table with the filtered data
            renderTableBody();
        }

        // Function for manual refresh
        async function refreshData(slurm_jobname) {
            const refreshBtn = document.getElementById('refresh-btn');
            const originalText = refreshBtn.innerHTML;

            // Disable the button and display a loading indicator
            refreshBtn.disabled = true;
            refreshBtn.innerHTML = '⏳ Actualisation...';

            try {
                await loadData(slurm_jobname);
                applyFieldPreset();
                filterTable();
            } catch (error) {
                console.error('Erreur lors du rafraîchissement:', error);
            } finally {
                // Re-enable the button
                refreshBtn.disabled = false;
                refreshBtn.innerHTML = originalText;
            }
        }

    </script>
</div>