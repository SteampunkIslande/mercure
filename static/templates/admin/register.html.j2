{% extends "base.html.j2" %}

{% block title %}Administration - Création d'utilisateur{% endblock %}

{% block banner_text %}Administration - Création d'utilisateur{% endblock %}

{% block body_attrs %} onload="init()"{% endblock %}

{% block content %}
    <div id="registerForm" class="form-vertical" style="margin: 1em auto;">
        <div>
            <label for="usermail">Adresse e-mail:</label>
            <input type="email" id="usermail" name="usermail" placeholder="Adresse e-mail" autocomplete="off" >
        </div>
        <div>
            <label for="username">Nom d'utilisateur:</label>
            <input type="text" id="username" name="username" placeholder="Nom d'utilisateur" autocomplete="off" >
        </div>
        <div>
            <label for="password">Mot de passe:</label>
            <input type="password" id="password" name="password" placeholder="Mot de passe" autocomplete="new-password" >
        </div>
        <a href="/mercure/admin/dashboard" class="btn btn-secondary">Retour au tableau de bord</a>
        <a id="create-user-button" class="btn btn-primary" onclick="submitForm()">Créer l'utilisateur</a>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        async function submitForm() {
            const usermail = document.getElementById('usermail').value;
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            try {
                const response = await fetch('/mercure/api/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ usermail, username, password })
                });
                const data = await response.json();
                if (isApiSuccess(data)) {
                    showMessage('success', 'Utilisateur créé avec succès');
                    clearForm();
                } else {
                    showMessage('error', getApiMessage(data));
                }
            } catch (error) {
                showMessage('error', error);
            }
        }

        function clearForm() {
            const container = document.getElementById('registerForm');
            if (container) {
                const inputs = container.querySelectorAll('input');
                inputs.forEach(input => input.value = '');
            }
        }

        function init() {
            clearForm();
        }
    </script>
{% endblock %}
