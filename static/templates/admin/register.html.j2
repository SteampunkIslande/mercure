{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Créer un utilisateur | SMAUG{% endblock %}
{% block body_class %}admin-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Administration · utilisateurs</p>
    <h1>Créer un utilisateur</h1>
    <p>Le compte pourra se connecter avec l’adresse e-mail fournie.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/admin/editusers">{{ ui.icon("users") }}Utilisateurs</a>
  </div>
</header>

<section class="panel form-card">
  <div class="panel-title">
    <div>{{ ui.icon("user-plus", "section-icon") }}<h2>Identité</h2></div>
  </div>
  <form id="register-form" class="form">
    <div class="form-grid">
      <div class="field">
        <label for="usermail">Adresse e-mail</label>
        <input type="email" id="usermail" name="usermail" placeholder="prenom.nom@exemple.fr" autocomplete="off" required>
      </div>
      <div class="field">
        <label for="username">Nom d’utilisateur</label>
        <input type="text" id="username" name="username" placeholder="Nom d’utilisateur" autocomplete="off" required>
      </div>
    </div>
    <div class="field">
      <label for="password">Mot de passe</label>
      <input type="password" id="password" name="password" placeholder="Mot de passe" autocomplete="new-password" required>
    </div>
    <div class="form-actions">
      <button id="create-user" class="btn" type="submit">{{ ui.icon("user-plus") }}Créer l’utilisateur</button>
      <a class="btn btn-secondary" href="/smaug/admin/dashboard">Annuler</a>
    </div>
  </form>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/admin-register.js"></script>
{% endblock %}
