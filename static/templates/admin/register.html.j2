<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Administration - Création d'utilisateur</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="/mercure/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/mercure/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/mercure/static/favicon.ico" />
    <script src="/mercure/static/scripts/show_message.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Administration - Création d'utilisateur</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>

    <form id="registerForm" class="form-vertical" style="margin: 1em auto;">
        <div>
            <label for="username">Nom d'utilisateur:</label>
            <input type="text" id="username" name="username" placeholder="Nom d'utilisateur" autocomplete="off"
                required>
        </div>
        <div>
            <label for="usermail">Adresse e-mail:</label>
            <input type="email" id="usermail" name="usermail" placeholder="Adresse e-mail" autocomplete="off" required>
        </div>
        <div>
            <label for="password">Mot de passe:</label>
            <input type="password" id="password" name="password" placeholder="Mot de passe" autocomplete="off" required>
        </div>
        <div class="error-msg" id="error-message" style="display: none;"></div>
        <div class="success-msg" id="success-message" style="display: none;"></div>
        <a href="/mercure/admin/dashboard" class="btn btn-secondary">Retour au tableau de bord</a>
        <a id="create-user-button" class="btn btn-primary">Créer l'utilisateur</a>
    </form>

    <script>
        document.getElementById('create-user-button').addEventListener('click', async (e) => {
            e.preventDefault();
            const usermail = document.getElementById('usermail').value;
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            try {
                const response = await fetch('/mercure/api/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ usermail, username, password })
                });

                const data = await response.json();

                if (isApiSuccess(data)) {
                    showMessage('success', 'Utilisateur créé avec succès');
                    document.getElementById('registerForm').reset();
                } else {
                    showMessage('error', getApiMessage(data));
                }
            } catch (error) {
                showMessage('error', 'Erreur de connexion au serveur');
            }
        });

        function init() {
            document.getElementById('registerForm').reset();
        }

        window.onload = function () {
            init();
        };

    </script>
</body>

</html>