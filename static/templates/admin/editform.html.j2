<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <title>{{ title }}</title>
    <script src="/static/scripts/newform_addgroup.js"></script>
    <script src="/static/scripts/userdefvars_edit.js"></script>
    <script src="/static/scripts/show_message.js"></script>

    <script>

        var userVarCounter = 0;
        {%if edit_mode %}
        var originalUserVars = {};
        {% endif %}

        async function updateUserVars() {
            const pipelineName = document.getElementById("pipeline_name").value;
            const launcherName = document.getElementById("launcher_name").value;

            if (!pipelineName || !launcherName) {
                return;
            }

            try {
                // 1) Récupérer les UDV requises pour le launcher
                const response = await fetch(`/mercure/api/parselauncher?pipeline=${encodeURIComponent(pipelineName)}&launcher=${encodeURIComponent(launcherName)}`);
                if (!response.ok) {
                    console.warn("Impossible de récupérer les UDV du launcher");
                    return;
                }
                const data = await response.json();
                let requiredVars = data.data || [];

                // Normaliser les UDV requises
                Object.entries(requiredVars).forEach(([varName, varDesc]) => {
                    requiredVars[varName] = { "description": varDesc };
                });

                await init();

                // 3) Afficher uniquement les cartes pour les variables requises
                Object.entries(requiredVars).forEach(([varName, varDetails], index) => {
                    addUserVar();
                    document.getElementById(`var_name_${index}`).value = varName;

                    {% if edit_mode %}
                    // Pré-remplir les valeurs si elles existent dans les UDV originales
                    let original = originalUserVars[varName];
                    if (original && typeof original === 'object') {
                        if (original.Constant) {
                            document.getElementById(`var_type_${index}`).value = "Constant";
                            document.getElementById(`var_values_${index}`).style.display = "block";
                            document.getElementById(`var_content_${index}`).value = original.Constant;
                        } else if (original.FromValuesList) {
                            document.getElementById(`var_type_${index}`).value = "FromValuesList";
                            document.getElementById(`var_values_${index}`).style.display = "block";
                            document.getElementById(`var_content_${index}`).value = original.FromValuesList.allowed.join("\n");
                        } else if (original.RunDefined) {
                            document.getElementById(`var_type_${index}`).value = "RunDefined";
                        }
                    }
                    {% endif %}
                    // Toujours afficher la description si présente
                    if (varDetails.description) {
                        const descText = document.getElementById(`var_description_text_${index}`);
                        const descDiv = document.getElementById(`var_description_${index}`);
                        if (descText && descDiv) {
                            descText.textContent = varDetails.description;
                            descDiv.style.display = "block";
                        }
                    }
                });

            } catch (error) {
                console.error("Erreur lors du chargement des UDV:", error);
            }
        }

        async function updateLauncherField() {
            var schema = {{ pipelines_struct | tojson
        }};
        const pipelineSelect = document.getElementById('pipeline_name');
        const launcherSelect = document.getElementById('launcher_name');
        let selectedPipeline = pipelineSelect.value;

        // Clear previous options
        launcherSelect.innerHTML = '';

        // Ajoute l'option vide par défaut
        var defaultOption = document.createElement('option');
        defaultOption.value = "";
        defaultOption.text = "-- Sélectionnez un launcher --";
        launcherSelect.appendChild(defaultOption);

        // Réinitialise la sélection à vide
        launcherSelect.value = "";

        if (selectedPipeline && schema[selectedPipeline]) {
            schema[selectedPipeline].forEach(function (val) {
                var option = document.createElement('option');
                option.value = val;
                option.text = val;
                launcherSelect.appendChild(option);
            });
            launcherSelect.parentElement.style.display = 'block';
        } else {
            launcherSelect.parentElement.style.display = 'none';
        }
        }

        document.addEventListener("DOMContentLoaded", async function () {
            await init();
            await load_groups();
            {% if edit_mode %}
            await fetchFormDefinition();
            {% endif %}
        });

        async function init() {
            const userVarsContainer = document.getElementById("user-vars-container");
            userVarsContainer.innerHTML = "";
            userVarCounter = 0;
        }
        {% if edit_mode %}
        async function fetchFormDefinition() {
            const formId = "{{ formid }}";
            const endpoint = `/mercure/api/forms/${formId}`;

            try {
                const response = await fetch(endpoint, {
                    method: "GET",
                    headers: {
                        "Content-Type": "application/json",
                    }
                });

                if (!response.ok) {
                    throw new Error("Erreur lors de la récupération du formulaire.");
                }

                const res = await response.json();
                const formDefinition = res.data;

                // Définir le nom du formulaire
                if (formDefinition.form_name) {
                    document.getElementById("form_name").value = formDefinition.form_name;
                    document.getElementById("form_name_display").textContent = formDefinition.form_name;
                    // Calculer la nouvelle version automatiquement
                    await getNextVersion(formDefinition.form_name);
                }

                // PIPELINE - sélectionner le pipeline existant si disponible
                if (formDefinition.pipeline_name) {
                    document.getElementById("pipeline_name").value = formDefinition.pipeline_name;
                    await updateLauncherField();
                }

                // LAUNCHER - sélectionner le launcher existant si disponible
                if (formDefinition.launcher_name) {
                    document.getElementById("launcher_name").value = formDefinition.launcher_name;
                }

                // Stocker les UDV existantes pour la fusion
                if (formDefinition.user_defined_vars) {
                    originalUserVars = formDefinition.user_defined_vars;
                }

                // Fusionner et afficher les UDV
                await updateUserVars();

                // GROUPES
                if (formDefinition.groups && Array.isArray(formDefinition.groups)) {
                    formDefinition.groups.forEach(group => {
                        const groupDiv = document.getElementById(`group_${group.id}`);
                        if (groupDiv) {
                            groupDiv.setAttribute("checked", null);
                        }
                    });
                }

            } catch (error) {
                console.error("Erreur lors de la récupération du formulaire :", error);
                showMessage("error", `Erreur lors de la récupération du formulaire : ${error.message}`, true);
            }
        }
        {% endif %}

        async function getNextVersion(formName) {
            try {
                const response = await fetch(`/mercure/api/nextversion?formname=${formName}`);
                if (!response.ok) {
                    throw new Error("Erreur lors de la récupération des formulaires.");
                }
                const data = await response.json();
                const nextVersion = data.data || [];

                document.getElementById("version").value = nextVersion;
                document.getElementById("version_display").textContent = nextVersion;
            } catch (error) {
                console.error("Erreur lors du calcul de la version:", error);
                document.getElementById("version").value = 1;
                document.getElementById("version_display").textContent = 1;
            }
        }

        async function submitForm() {
            const pipelineName = document.getElementById("pipeline_name").value;
            const launcherName = document.getElementById("launcher_name").value;
            const formName = document.getElementById("form_name").value;

            const indirType = document.getElementById("indir_type").value;

            const selectedGroups = Array.from(
                document.querySelectorAll('input[name="selected_groups"]:checked')
            ).map((input) => {
                const groupId = parseInt(input.value);
                const groupName = input.nextElementSibling?.textContent?.trim() || "Nom inconnu";
                return { id: groupId, name: groupName };
            });

            userVars = {};
            document.querySelectorAll(".user-var-item").forEach((item) => {
                const varName = item.querySelector('input[type="text"]').value;
                const varType = item.querySelector("select").value;

                if (!varName.trim() || !varType.trim()) {
                    return;
                }

                const varContent = item.querySelector("textarea")?.value || null;

                userVars[varName] = {};
                if (varType === "FromValuesList") {
                    userVars[varName][varType] = { allowed: varContent.split("\n") };
                }
                if (varType === "RunDefined") {
                    userVars[varName][varType] = null;
                }
                if (varType === "Constant") {
                    userVars[varName][varType] = varContent;
                }
            });

            // Vérification des variables requises non définies
            let missingVars = [];
            try {
                // On récupère la liste des UDV requises pour le launcher
                const response = await fetch(`/mercure/api/parselauncher?pipeline=${encodeURIComponent(pipelineName)}&launcher=${encodeURIComponent(launcherName)}`);
                if (response.ok) {
                    const data = await response.json();
                    let requiredVars = data.data || [];
                    Object.keys(requiredVars).forEach((varName) => {
                        if (!userVars[varName]) {
                            missingVars.push(varName);
                        }
                    });
                }
            } catch (e) {
                // Ignore l'erreur ici, on continue
            }

            if (missingVars.length > 0) {
                const msg = "Attention : les variables suivantes n'ont pas été définies :\n\n" +
                    missingVars.map(v => `- \`${v}\``).join("\n") +
                    "\n\nVoulez-vous continuer la création du formulaire ?";
                if (!window.confirm(msg)) {
                    return;
                }
            }

            // Obtenir la version la plus récente juste avant la soumission
            let version = 1;
            try {
                const response = await fetch(`/mercure/api/nextversion?formname=${formName}`);
                if (response.ok) {
                    const data = await response.json();
                    version = data.data || 1;
                }
            } catch (e) {
                // Ignore l'erreur ici, on continue
            }

            if (Object.keys(userVars).length === 0) {
                userVars = null;
            }

            const formData = {
                pipeline_name: pipelineName,
                launcher_name: launcherName,
                form_name: formName,
                groups: selectedGroups,
                user_defined_vars: userVars,
                enabled: true,
                version: parseInt(version) || 1,
                indir_type: indirType,
            };

            try {
                const response = await fetch("/mercure/api/newform", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(formData),
                });
                if (!response.ok) {
                    throw new Error("Erreur lors de la création de la nouvelle version du formulaire.");
                }
                const data = await response.json();
                if (!data.success) {
                    throw new Error(data.message);
                }
                const message = data.data;
                window.location = "/mercure/api/redirect?target_url=/mercure/admin/show/forms" +
                    "&title=" + encodeURIComponent("Succès") +
                    "&message=" + encodeURIComponent(message) +
                    "&seconds=5";
            } catch (error) {
                console.error("Erreur:", error);
                showMessage("error", `Erreur lors de la création du formulaire : ${error.message}`, true);
            }
        }
    </script>

</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">{{ title }}</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>
    <div id="error-message" style="display: none;" class="error-msg">
    </div>
    <form>
        <div style="width: 50%;">
            <label for="pipeline_name">Pipeline :</label>
            <select id="pipeline_name" name="pipeline_name" onchange="updateLauncherField()" required
                style="float:right;width:50%;">
                <option value="">-- Sélectionnez un pipeline --</option>
                {% for key in pipelines_struct %}
                <option value="{{ key }}">{{ key }}</option>
                {% endfor %}
            </select>
        </div>
        <div id="launcher-container" style="display:none; width: 50%;">
            <label for="launcher_name">Launcher :</label>
            <select id="launcher_name" name="launcher_name" required style="float:right;width:50%;">
                <!-- Options will be populated by JS -->
            </select>
        </div>
        {% if edit_mode %}
        <div style="width: 50%;">
            <label>Nom du formulaire :</label>
            <strong id="form_name_display" style="float:right"></strong>
            <input type="hidden" id="form_name" name="form_name">
        </div>
        {% else %}
        <div style="width: 50%;">
            <label for="form_name">Nom du formulaire :</label>
            <input type="text" id="form_name" name="form_name" onchange="getNextVersion(this.value)" required
                style="float:right">
        </div>
        {% endif %}
        <div style="width: 50%;">
            <label>Version :</label>
            <strong id="version_display" style="float:right"></strong>
            <input type="hidden" id="version" name="version">
        </div>
        <div style="width: 50%;">
            <label for="indir_type">Type de dossier d'entrée:</label>
            <select id="indir_type" name="indir_type" required style="float:right;width:50%;">
                <option value="">-- Sélectionnez un type --</option>
                <option value="BclDir">Dossier de run Illumina</option>
                <option value="AnalysisDir">Dossier d'analyse</option>
                <option value="OntDir">Dossier Gridion</option>
            </select>
        </div>
        <fieldset>
            <legend>Groupes</legend>
            <div id="groups-container">
            </div>
            <div>
                <label for="new_group_name">Créer un nouveau groupe :</label>
                <input type="text" id="new_group_name" name="new_group_name" placeholder="Nom du nouveau groupe">
                <button type="button" onclick="addNewGroup()">Ajouter</button>
            </div>
        </fieldset>

        <div id="udv_section">
            <h3 class="title">Variables définies par l'utilisateur</h3>
            <div id="user-vars-container">
            </div>
        </div>
    </form>

    {% if edit_mode %}
    <!-- Centered submit button at the bottom of the page -->
    <div style="text-align: left; margin-top: 20px;">
        <a class="btn btn-secondary" href="/mercure/admin/show/forms">Retour à la liste des formulaires</a>
        <a class="btn btn-primary" onclick="submitForm()">Créer une nouvelle version</a>
    </div>
    {% else %}
    <!-- Centered submit button at the bottom of the page -->
    <div style="text-align: left; margin-top: 20px;">
        <a class="btn btn-secondary" href="/mercure/admin/show/forms">Retour à la liste des formulaires</a>
        <a class="btn btn-primary" onclick="submitForm()">Créer un formulaire</a>
    </div>
    {% endif %}

    <script>
        // Show/hide launcher container based on pipeline selection
        document.getElementById('pipeline_name').addEventListener('change', async function () {
            const launcherContainer = document.getElementById('launcher-container');
            await init();
            if (this.value) {
                launcherContainer.style.display = 'block';
            } else {
                launcherContainer.style.display = 'none';
            }
        });

        // Déclencher la fusion des UDV quand le launcher change
        document.getElementById('launcher_name').addEventListener('change', async function () {
            await init();
            if (this.value) {
                await updateUserVars();
            }
        });
    </script>
</body>

</html>