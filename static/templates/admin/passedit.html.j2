{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Mot de passe | SMAUG{% endblock %}
{% block body_class %}admin-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">{% if auth_user.is_admin %}Administration{% else %}Mon compte{% endif %}</p>
    <h1>Modifier le mot de passe</h1>
    <p>Compte de {{ edited_user.username }}</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="{% if auth_user.is_admin %}/smaug/admin/editusers{% else %}/smaug/home{% endif %}">{{ ui.icon("arrow-left") }}Retour</a>
  </div>
</header>

<section class="panel form-card">
  <div class="panel-title">
    <div>{{ ui.icon("lock", "section-icon") }}<h2>Sécurité</h2></div>
  </div>
  <form id="password-form" class="form">
    {% if not auth_user.is_admin %}
    <div class="field">
      <label for="old_password">Mot de passe actuel</label>
      <input type="password" id="old_password" name="old_password" autocomplete="current-password" required>
    </div>
    {% endif %}
    <div class="field">
      <label for="new_password">Nouveau mot de passe</label>
      <input type="password" id="new_password" name="new_password" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="new_password_confirm">Confirmation du mot de passe</label>
      <input type="password" id="new_password_confirm" name="new_password_confirm" autocomplete="new-password" required>
    </div>
    <div class="form-actions">
      <button id="save-password" class="btn" type="submit">{{ ui.icon("save") }}Modifier le mot de passe</button>
    </div>
  </form>
</section>

<script type="application/json" id="page-data">{{ {"userId": edited_user.id, "isAdmin": auth_user.is_admin} | tojson }}</script>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/admin-password.js"></script>
{% endblock %}
