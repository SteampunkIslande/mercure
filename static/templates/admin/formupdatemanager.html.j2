<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionnaire de mise à jour des formulaires</title>
    <link rel="stylesheet" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />

    <script src="/static/scripts/show_message.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Gestionnaire de mise à jour des formulaires</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>

    <div id="info-message" class="info-msg" style="display:none;"></div>
    <div id="error-message" class="error-msg" style="display:none;"></div>
    <div id="success-message" class="success-msg" style="display:none;"></div>
    
    <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
        <div id="search-forms" style="display: flex; gap: 0.5em; align-items: center;">
            <input type="text" id="form-search" placeholder="Rechercher un formulaire..."
                style="padding: 0.5em; width: 250px; border-radius: 4px; border: 1px solid #bbb;"
                oninput="filterForms()">
        </div>
    </div>

    <table id="forms-update-table">
        <thead>
            <tr>
                <th class="content-column">Nom du formulaire</th>
                <th class="numeric-column padding-x centered">Statut</th>
                <th class="numeric-column padding-x centered">Action</th>
            </tr>
        </thead>
        <tbody id="forms-table-body">
            <!-- Les lignes seront ajoutées dynamiquement par JavaScript -->
        </tbody>
    </table>

    <!-- Contrôles de pagination -->
    <div id="pagination-controls"
        style="margin: 10px 0; text-align: center; display: none; align-items: center; justify-content: center; gap: 10px; font-size: 0.9rem;">
        <button id="first-page-btn" class="pagination-btn" onclick="firstPage()" disabled>
            <span class="material-icons" style="font-size: 16px;">first_page</span>
        </button>

        <button id="prev-page-btn" class="pagination-btn" onclick="loadPreviousPage()" disabled>
            <span class="material-icons" style="font-size: 16px;">chevron_left</span>
        </button>

        <div style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.85rem;">
            <span>Page</span>
            <input id="page-input" type="number" min="1" class="pagination-input" onchange="onPageInputChange()"
                onkeypress="if(event.key==='Enter') onPageInputChange()">
            <span id="page-info">/ 1</span>
        </div>

        <button id="next-page-btn" class="pagination-btn" onclick="loadNextPage()" disabled>
            <span class="material-icons" style="font-size: 16px;">chevron_right</span>
        </button>

        <button id="last-page-btn" class="pagination-btn" onclick="lastPage()" disabled>
            <span class="material-icons" style="font-size: 16px;">last_page</span>
        </button>

        <div style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.85rem; margin-left: 15px;">
            <input id="per-page-select" class="pagination-select" onchange="changePageSize()" type="number" min="1" max="100" value="10">
            <span>par page</span>
        </div>
    </div>

    <style>

        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.9em;
            font-weight: bold;
        }

        .status-uptodate {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status-archived {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .status-unknown {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }

        /* Styles de pagination */
        .pagination-btn {
            padding: 6px 10px;
            font-size: 0.85rem;
            background-color: #6c757d;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            transition: background-color 0.2s ease;
        }

        .pagination-btn:hover:not(:disabled) {
            background-color: #5a6268;
        }

        .pagination-btn:disabled {
            background-color: #d6d8db;
            color: #6c757d;
            cursor: not-allowed;
        }

        .pagination-input {
            width: 45px;
            padding: 4px;
            font-size: 0.8rem;
            text-align: center;
            border: 1px solid #ccc;
            border-radius: 3px;
        }

        .pagination-input:focus {
            outline: none;
            border-color: #007bff;
        }

        .pagination-select {
            padding: 4px 8px;
            font-size: 0.8rem;
            border: 1px solid #ccc;
            border-radius: 3px;
            background-color: white;
            min-width: 50px;
        }

        .pagination-select:focus {
            outline: none;
            border-color: #007bff;
        }
    </style>

    <script>
        let formsData = [];
        let currentPage = 1;
        let perPage = 10;
        let totalPages = 1;
        let allFormsData = []; // Pour le filtrage local

        async function loadFormStatus(page = 1, pageSize = 10) {
            const tableBody = document.getElementById('forms-table-body');
            const paginationContainer = document.getElementById('pagination-controls');
            
            tableBody.innerHTML = '';
            paginationContainer.style.display = 'none';

            try {
                // Utiliser la nouvelle route paginée
                const response = await fetch(`/mercure/api/update-form-status?page=${page}&per_page=${pageSize}`);
                const data = await response.json();
                
                if (data.success && data.data) {
                    formsData = data.data.items;
                    allFormsData = [...formsData]; // Copie pour le filtrage
                    
                    // Mettre à jour les variables de pagination
                    currentPage = data.data.pagination.current_page;
                    perPage = data.data.pagination.per_page;
                    totalPages = data.data.pagination.total_pages;
                    
                    displayForms(formsData);
                    updatePaginationControls(data.data.pagination);
                    paginationContainer.style.display = 'flex';
                } else {
                    showMessage('error', data.message || 'Erreur lors du chargement des formulaires');
                }
            } catch (error) {
                showMessage('error', `Erreur: ${error.message}`);
            }
        }

        function displayForms(forms) {
            const tableBody = document.getElementById('forms-table-body');
            tableBody.innerHTML = '';

            forms.forEach(form => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td class="content-column">
                        <strong>${form.form_name}</strong><br>
                        <small>Version ${form.version} • ID: ${form.form_id}</small>
                    </td>
                    <td class="numeric-column centered">
                        <span class="status-badge ${getStatusClass(form.status)}">
                            ${getStatusText(form.status)}
                        </span>
                    </td>
                    <td class="numeric-column centered">
                        <a class="btn btn-primary" onclick="updateForm('${form.form_id}', '${form.form_name}')">
                            Mettre à jour
                        </a>
                    </td>
                `;
                tableBody.appendChild(row);
            });
        }

        function getStatusClass(status) {
            switch (status) {
                case 'uptodate':
                    return 'status-uptodate';
                case 'archived':
                    return 'status-archived';
                default:
                    return 'status-unknown';
            }
        }

        function getStatusText(status) {
            switch (status) {
                case 'uptodate':
                    return 'À jour';
                case 'archived':
                    return 'Archivé';
                default:
                    return status;
            }
        }

        function updatePaginationControls(pagination) {
            const firstBtn = document.getElementById("first-page-btn");
            const prevBtn = document.getElementById("prev-page-btn");
            const nextBtn = document.getElementById("next-page-btn");
            const lastBtn = document.getElementById("last-page-btn");
            const pageInput = document.getElementById("page-input");
            const pageInfo = document.getElementById("page-info");
            const perPageSelect = document.getElementById('per-page-select');

            // Mise à jour des boutons de navigation
            firstBtn.disabled = pagination.current_page <= 1;
            prevBtn.disabled = !pagination.has_previous_page;
            nextBtn.disabled = !pagination.has_next_page;
            lastBtn.disabled = pagination.current_page >= pagination.total_pages;
            
            // Mise à jour du champ de saisie de page et des informations
            pageInput.value = pagination.current_page;
            pageInfo.textContent = `/ ${pagination.total_pages}`;
            
            // Mise à jour de la sélection de la taille de page
            perPageSelect.value = pagination.per_page;

            // Mettre à jour les variables globales
            currentPage = pagination.current_page;
            totalPages = pagination.total_pages;
        }

        async function goToPage(page) {
            if (page >= 1 && page <= totalPages) {
                await loadFormStatus(page, perPage);
            }
        }

        function loadPage(page) {
            goToPage(page);
        }

        async function loadPreviousPage() {
            if (currentPage > 1) {
                await goToPage(currentPage - 1);
            }
        }

        async function loadNextPage() {
            if (currentPage < totalPages) {
                await goToPage(currentPage + 1);
            }
        }

        async function firstPage() {
            await goToPage(1);
        }

        async function lastPage() {
            await goToPage(totalPages);
        }

        async function onPageInputChange() {
            const pageInput = document.getElementById("page-input");
            const page = parseInt(pageInput.value);
            if (page >= 1 && page <= totalPages) {
                await goToPage(page);
            } else {
                pageInput.value = currentPage;
            }
        }

        function changePageSize() {
            const newPerPage = parseInt(document.getElementById('per-page-select').value);
            perPage = newPerPage;
            loadFormStatus(1, newPerPage); // Retourner à la page 1 lors du changement de taille
        }

        async function updateForm(formId, formName) {
            if (!confirm(`Êtes-vous sûr de vouloir actualiser le formulaire "${formName}" ?`)) {
                return;
            }

            try {
                
                const response = await fetch(`/mercure/api/update-form/${formId}`);
                
                const data = await response.json();
                
                if (data.success) {
                    showMessage('success', `Formulaire "${formName}" actualisé avec succès`);
                    // Recharger la liste pour voir les changements
                    await loadFormStatus(currentPage, perPage);
                } else {
                    showMessage('error', data.message || 'Erreur lors de la mise à jour du formulaire');
                }
            } catch (error) {
                showMessage('error', `Erreur de connexion: ${error.message}`);
            }
        }

        function filterForms() {
            const query = document.getElementById('form-search').value.toLowerCase();
            
            if (query.trim() === '') {
                // Si pas de recherche, afficher tous les formulaires de la page courante
                displayForms(formsData);
            } else {
                // Filtrer les formulaires de la page courante
                const filteredForms = formsData.filter(form =>
                    form.form_name.toLowerCase().includes(query) ||
                    form.status.toLowerCase().includes(query) ||
                    form.form_id.toString().includes(query)
                );
                displayForms(filteredForms);
            }
        }
        // Charger les données au chargement de la page
        document.addEventListener('DOMContentLoaded', () => {
            loadFormStatus();
        });
    </script>

    <div style="margin-top: 20px;">
        <a href="/mercure/admin/dashboard" class="btn btn-secondary">Retour au tableau de bord</a>
        <a href="/mercure/admin/show/forms" class="btn btn-secondary">Liste des formulaires</a>
    </div>
</body>

</html>