    </script>

</head>

<body>
    <h1 class="title">Nouveau formulaire de pipeline</h1>
    <form>
        <div>
            <label for="pipeline_name">Pipeline :</label>
            <select id="pipeline_name" name="pipeline_name" onchange="updateValues()" required>
                <option value="">-- Sélectionnez un pipeline --</option>
                {% for key in pipelines_struct %}
                <option value="{{ key }}">{{ key }}</option>
                {% endfor %}
            </select>
        </div>

        <div id="launcher-container" style="display:none;">
            <label for="launcher_name">Launcher :</label>
            <select id="launcher_name" name="launcher_name" required>
                <!-- Options will be populated by JS -->
            </select>
        </div>

        <div>
            <label for="form_name">Nom du formulaire :</label>
            <input type="text" id="form_name" name="form_name" required>
        </div>

        <fieldset>
            <legend>Groupes</legend>
            <div id="groups-container">
                {% for group in groups %}
                <div class="group-checkbox">
                    <input type="checkbox" id="group_{{ group.group_id }}" name="selected_groups"
                        value="{{ group.group_id }}">
                    <label for="group_{{ group.group_id }}">{{ group.group_name }} (ID: {{ group.group_id }})</label>
                </div>
                {% endfor %}
                <div>
                    <label for="new_group_name">Créer un nouveau groupe :</label>
                    <input type="text" id="new_group_name" name="new_group_name" placeholder="Nom du nouveau groupe">
                    <button type="button" onclick="addNewGroup()">Ajouter</button>
                </div>
                <script>
                    let pendingGroups = [];

                    function addNewGroup() {
                        const newGroupName = document.getElementById("new_group_name").value.trim();
                        if (!newGroupName) {
                            alert("Veuillez entrer un nom pour le nouveau groupe.");
                            return;
                        }

                        // Check for duplicate group names
                        const existingGroups = Array.from(document.querySelectorAll('input[name="selected_groups"]'))
                            .map(input => input.nextElementSibling?.textContent?.trim());

                        if (existingGroups.includes(newGroupName)) {
                            alert("Ce nom de groupe existe déjà. Veuillez en choisir un autre.");
                            return;
                        }

                        // Add to pending groups
                        pendingGroups.push(newGroupName);

                        // Create a new group element
                        const groupsContainer = document.getElementById("groups-container");
                        const groupId = `new_group_${Date.now()}`; // Unique ID based on timestamp
                        const groupDiv = document.createElement("div");
                        groupDiv.className = "group-checkbox";
                        groupDiv.innerHTML = `
                            <input type="checkbox" id="${groupId}" name="selected_groups" value="${groupId}" checked>
                            <label for="${groupId}">${newGroupName} (Nouveau)</label>
                        `;
                        groupsContainer.appendChild(groupDiv);

                        // Clear the input field
                        document.getElementById("new_group_name").value = "";
                    }

                </script>
            </div>
        </fieldset>

        <div>
            <h3 class="title">Variables définies par l'utilisateur</h3>
            <div id="user-vars-container">
            </div>
            <button type="button" onclick="addUserVar()">Ajouter une variable</button>
        </div>
    </form>

    <!-- Centered submit button at the bottom of the page -->
    <div style="text-align: center; margin-top: 20px;">
        <button class="btn btn-primary" onclick="onSubmit()">Envoyer</button>
    </div>

    <script>
        // Show/hide launcher container based on pipeline selection
        document.getElementById('pipeline_name').addEventListener('change', function () {
            var launcherContainer = document.getElementById('launcher-container');
            if (this.value) {
                launcherContainer.style.display = 'block';
            } else {
                launcherContainer.style.display = 'none';
            }
        });
    </script>
</body>

</html>