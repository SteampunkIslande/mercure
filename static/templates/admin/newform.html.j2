        //                groupDiv.innerHTML = `
        //                    <input type="checkbox" id="group_${data.group_id}" name="selected_groups" value="${data.group_id}" checked>
        //                    <label for="group_${data.group_id}">${data.group_name} (ID: ${data.group_id})</label>
        //                `;
        //                groupsContainer.appendChild(groupDiv);
        //            } else {
        //                throw new Error("Réponse invalide du serveur.");
        //            }
        //        })
        //        .catch((error) => {
        //            alert(error.message);
        //            return; // Stop form submission
        //        });
        //}

        const pipelineName = document.getElementById("pipeline_name").value;
        const launcherName = document.getElementById("launcher_name").value;
        const formName = document.getElementById("form_name").value;

        const selectedGroups = Array.from(
            document.querySelectorAll('input[name="selected_groups"]:checked')
        ).map((input) => {
            const groupId = input.value;
            const groupName = input.nextElementSibling?.textContent?.trim() || "Nom inconnu";
            return { id: groupId, name: groupName };
        });

        const newGroupName = document.getElementById("new_group_name").value.trim();
        if (newGroupName) {
            selectedGroups.push({ id: null, name: newGroupName });
        }

        const userVars = {};
        document.querySelectorAll(".user-var-item").forEach((item) => {
            const varName = item.querySelector('input[type="text"]').value;
            const varType = item.querySelector("select").value;
            const varContent = item.querySelector("textarea")?.value || null;

            if (varType === "FromValuesList") {
                userVars[varName] = { allowed: varContent.split("\n") };
            } else if (varType === "Constant") {
                userVars[varName] = [varContent];
            } else if (varType === "RunDefined") {
                userVars[varName] = null;
            }
        });

        const formData = {
            pipeline_name: pipelineName,
            launcher_name: launcherName,
            form_name: formName,
            groups: selectedGroups,
            user_defined_vars: userVars,
        };

        fetch("/mercure/api/newform", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify(formData),
        })
            .then((response) => {
                if (response.ok) {
                    alert("Formulaire soumis avec succès.");
                } else {
                    alert("Erreur lors de la soumission du formulaire.");
