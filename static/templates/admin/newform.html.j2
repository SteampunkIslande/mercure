<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico" />
    <title>{{ title }}</title>
    <script src="/static/scripts/newform_addgroup.js"></script>
    <script src="/static/scripts/userdefvars_edit.js"></script>
    <script src="/static/scripts/utils.js"></script>
    <script>

        let userVarCounter = 0;

        function updateLauncherField() {
            var schema = {{ pipelines_struct | tojson
        }};
        var pipelineSelect = document.getElementById('pipeline_name');
        var launcherSelect = document.getElementById('launcher_name');
        var selectedPipeline = pipelineSelect.value;

        // Clear previous options
        launcherSelect.innerHTML = '';

        // Ajoute l'option vide par défaut
        var defaultOption = document.createElement('option');
        defaultOption.value = "";
        defaultOption.text = "-- Sélectionnez un launcher --";
        launcherSelect.appendChild(defaultOption);

        // Réinitialise la sélection à vide
        launcherSelect.value = "";

        if (selectedPipeline && schema[selectedPipeline]) {
            schema[selectedPipeline].forEach(function (val) {
                var option = document.createElement('option');
                option.value = val;
                option.text = val;
                launcherSelect.appendChild(option);
            });
            launcherSelect.parentElement.style.display = 'block';
        } else {
            launcherSelect.parentElement.style.display = 'none';
        }
        }

        document.addEventListener("DOMContentLoaded", function () {
            init();
            addUserVar();
            load_groups();
            updateLauncherField();
            {%if formid %}
            fetchFormDefinition();
            {% endif %}
        });

        function init() {
            userVarCounter = 0;
        }

        // Only fetch form definition in case we are in edit mode
        {%if formid %}

        function fetchFormDefinition() {

            const formId = "{{ formid }}"; // Read formid from template context

            const endpoint = `/mercure/api/forms/${formId}`;
            fetch(endpoint, {
                method: "GET",
                headers: {
                    "Content-Type": "application/json",
                },
            }).then(response => {
                if (!response.ok) {
                    throw new Error("Erreur lors de la récupération du formulaire.");
                }
                return response.json();
            }).then((res) => {
                const formDefinition = res.data;
                const pipelinesStruct = {{ pipelines_struct | tojson
            }};
        updateLauncherField();

        // PIPELINE
        if (formDefinition.pipeline_name) {
            if (!pipelinesStruct.hasOwnProperty(formDefinition.pipeline_name)) {
                // Pipeline archivé
                document.getElementById("pipeline_name").style.display = "none";
                let archivedLabel = document.getElementById("archived-pipeline-label");
                if (!archivedLabel) {
                    archivedLabel = document.createElement("span");
                    archivedLabel.id = "archived-pipeline-label";
                    archivedLabel.style.fontWeight = "bold";
                    archivedLabel.textContent = formDefinition.pipeline_name + " (archivé)";
                    document.getElementById("pipeline_name").parentElement.appendChild(archivedLabel);
                }
            } else {
                document.getElementById("pipeline_name").onchange = null;
                document.getElementById("pipeline_name").value = formDefinition.pipeline_name;
                updateLauncherField();
                document.getElementById("pipeline_name").onchange = updateLauncherField;
                let archivedLabel = document.getElementById("archived-pipeline-label");
                if (archivedLabel) archivedLabel.remove();
                document.getElementById("pipeline_name").style.display = "";
            }
        }

        // LAUNCHER
        if (formDefinition.launcher_name) {
            let validLauncher = false;
            if (formDefinition.pipeline_name && pipelinesStruct.hasOwnProperty(formDefinition.pipeline_name)) {
                validLauncher = pipelinesStruct[formDefinition.pipeline_name].includes(formDefinition.launcher_name);
            }
            if (!validLauncher) {
                document.getElementById("launcher_name").style.display = "none";
                let archivedLabel = document.getElementById("archived-launcher-label");
                if (!archivedLabel) {
                    archivedLabel = document.createElement("span");
                    archivedLabel.id = "archived-launcher-label";
                    archivedLabel.style.fontWeight = "bold";
                    archivedLabel.textContent = formDefinition.launcher_name + " (archivé)";
                    document.getElementById("launcher_name").parentElement.appendChild(archivedLabel);
                }
                document.getElementById("launcher-container").style.display = "block";
            } else {
                document.getElementById("launcher_name").value = formDefinition.launcher_name;
                document.getElementById("launcher_name").style.display = "";
                let archivedLabel = document.getElementById("archived-launcher-label");
                if (archivedLabel) archivedLabel.remove();
                document.getElementById("launcher-container").style.display = "block";
            }
        }

        if (formDefinition.version) {
            document.getElementById("version").value = formDefinition.version;
        }

        if (formDefinition.form_name) {
            document.getElementById("form_name").value = formDefinition.form_name;
        }

        if (formDefinition.groups && Array.isArray(formDefinition.groups)) {
            const groupsContainer = document.getElementById("groups-container");
            formDefinition.groups.forEach(group => {
                const groupDiv = document.getElementById(`group_${group.id}`)
                groupDiv.setAttribute("checked", null);
            });
        }

        if (formDefinition.user_defined_vars) {
            const userVarsContainer = document.getElementById("user-vars-container");
            userVarsContainer.innerHTML = ""; // Clear existing user vars
            userVarCounter = 0;

            Object.entries(formDefinition.user_defined_vars).forEach(([varName, varDetails], index) => {
                addUserVar();
                document.getElementById(`var_name_${index}`).value = varName;
                if (isVarTypeOf(varDetails, Object)) {
                    if (varDetails.Constant) {
                        document.getElementById(`var_type_${index}`).value = "Constant";
                        document.getElementById(`var_values_${index}`).style.display = "block";
                        document.getElementById(`var_content_${index}`).value = varDetails.Constant;
                    }
                    if (varDetails.FromValuesList) {
                        document.getElementById(`var_type_${index}`).value = "FromValuesList";
                        document.getElementById(`var_values_${index}`).style.display = "block";
                        document.getElementById(`var_content_${index}`).value = varDetails.FromValuesList.allowed.join("\n");
                    }
                }
                else {
                    // Seule exception, si on n'a ni valeurs permises, ni valeur constante, c'est que c'est une variable définie au lancement
                    document.getElementById(`var_type_${index}`).value = "RunDefined";
                }
            });
        }
            }).catch ((error) => {
            console.error("Erreur:", error);
            const errorDiv = document.getElementById("error-message");
            errorDiv.textContent = error;
            errorDiv.style.display = "block";
            setTimeout(() => {
                errorDiv.style.display = 'none';
            }, 8000);
        });
        }

        {% endif %}
    </script>

    <script>
        function submitForm() {
            const pipelineName = document.getElementById("pipeline_name").value;
            const launcherName = document.getElementById("launcher_name").value;
            const formName = document.getElementById("form_name").value;
            const version = document.getElementById("version").value;

            const selectedGroups = Array.from(
                document.querySelectorAll('input[name="selected_groups"]:checked')
            ).map((input) => {
                const groupId = parseInt(input.value);
                const groupName = input.nextElementSibling?.textContent?.trim() || "Nom inconnu";
                return { id: groupId, name: groupName };
            });

            userVars = {};
            document.querySelectorAll(".user-var-item").forEach((item) => {
                const varName = item.querySelector('input[type="text"]').value;
                const varType = item.querySelector("select").value;

                if (!varName.trim() || !varType.trim()) {
                    return;
                }

                const varContent = item.querySelector("textarea")?.value || null;

                userVars[varName] = {};
                if (varType === "FromValuesList") {
                    userVars[varName][varType] = { allowed: varContent.split("\n") };
                }
                if (varType === "RunDefined") {
                    userVars[varName][varType] = null;
                }
                if (varType === "Constant") {
                    userVars[varName][varType] = varContent;
                }
            });

            if (Object.keys(userVars).length === 0) {
                userVars = null;
            }

            const formData = {
                pipeline_name: pipelineName,
                launcher_name: launcherName,
                form_name: formName,
                groups: selectedGroups,
                user_defined_vars: userVars,
                enabled: true,
                version: parseInt(version) || -1
            };

            fetch("/mercure/api/newform", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(formData),
            })
                .then((response) => {
                    if (response.ok) {
                        return response.json(); // Extract JSON from the response
                    } else {
                        throw new Error("Erreur lors de la soumission du formulaire.");
                    }
                })
                .then((data) => {
                    if (!data.success) {
                        throw new Error(data.message);
                    }
                    const message = data.data || "Opération réussie"; // Retrieve the message
                    window.location.href = `/mercure/success?origin=${document.URL}&message=${encodeURIComponent(message)}`;
                })
                .catch((error) => {
                    console.error("Erreur:", error);
                    const errorDiv = document.getElementById("error-message");
                    errorDiv.textContent = error;
                    errorDiv.style.display = "block";
                    setTimeout(() => {
                        errorDiv.style.display = 'none';
                    }, 8000);
                });
        }
    </script>

</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">{{ title }}</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>
    <div id="error-message" style="display: none;" class="error-msg">
    </div>
    <form>
        <div>
            <label for="pipeline_name">Pipeline :</label>
            <select id="pipeline_name" name="pipeline_name" onchange="updateLauncherField()" required>
                <option value="">-- Sélectionnez un pipeline --</option>
                {% for key in pipelines_struct %}
                <option value="{{ key }}">{{ key }}</option>
                {% endfor %}
            </select>
        </div>
        <div id="launcher-container" style="display:none;">
            <label for="launcher_name">Launcher :</label>
            <select id="launcher_name" name="launcher_name" required>
                <!-- Options will be populated by JS -->
            </select>
        </div>
        <div>
            <label for="version">Version :</label>
            <input type="number" id="version" name="version" required>
        </div>

        <div>
            <label for="form_name">Nom du formulaire :</label>
            <input type="text" id="form_name" name="form_name" required>
        </div>

        <fieldset>
            <legend>Groupes</legend>
            <div id="groups-container">
            </div>
            <div>
                <label for="new_group_name">Créer un nouveau groupe :</label>
                <input type="text" id="new_group_name" name="new_group_name" placeholder="Nom du nouveau groupe">
                <button type="button" onclick="addNewGroup()">Ajouter</button>
            </div>
        </fieldset>

        <div>
            <h3 class="title">Variables définies par l'utilisateur</h3>
            <div id="user-vars-container">
            </div>
            <button type="button" onclick="addUserVar()">Ajouter une variable</button>
        </div>
    </form>

    <div style="text-align: center; margin-top: 20px;">
        <button class="btn btn-primary" onclick="submitForm()">{{ submit_string }}</button>
    </div>
    <!-- Centered submit button at the bottom of the page -->
    <div style="text-align: center; margin-top: 20px;">
        <a class="btn btn-secondary" href="/mercure/admin/show/forms">Retour à la liste des formulaires</a>
        <a class="btn btn-secondary" href="/mercure/admin/dashboard">Retour au tableau de bord</a>
    </div>

    <script>
        // Show/hide launcher container based on pipeline selection
        document.getElementById('pipeline_name').addEventListener('change', function () {
            var launcherContainer = document.getElementById('launcher-container');
            if (this.value) {
                launcherContainer.style.display = 'block';
            } else {
                launcherContainer.style.display = 'none';
            }
        });
    </script>
</body>

</html>