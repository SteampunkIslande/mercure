<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="/static/style.css">
    <title>Nouveau formulaire de pipeline</title>
    <script src="/static/scripts/newform_addgroup.js"></script>
    <script>

        let userVarCounter = 0;
        let pendingGroups = [];

        function updateValues() {
            var schema = {{ pipelines_struct | tojson
        }};
        var pipelineSelect = document.getElementById('pipeline_name');
        var launcherSelect = document.getElementById('launcher_name');
        var selectedPipeline = pipelineSelect.value;

        // Clear previous options
        launcherSelect.innerHTML = '';

        if (selectedPipeline && schema[selectedPipeline]) {
            schema[selectedPipeline].forEach(function (val) {
                var option = document.createElement('option');
                option.value = val;
                option.text = val;
                launcherSelect.appendChild(option);
            });
            launcherSelect.parentElement.style.display = 'block';
        } else {
            launcherSelect.parentElement.style.display = 'none';
        }
        }

        function addUserVar() {
            const container = document.getElementById('user-vars-container');
            const div = document.createElement('div');
            div.className = 'user-var-item';
            div.innerHTML = `
                <label for="var_name_${userVarCounter}">Nom de la variable :</label>
                <input type="text" id="var_name_${userVarCounter}" name="user_defined_vars[${userVarCounter}][name]" required>
                
                <label for="var_type_${userVarCounter}">Type :</label>
                <select id="var_type_${userVarCounter}" name="user_defined_vars[${userVarCounter}][type]" onchange="updateVarType(${userVarCounter})" required>
                    <option value="">-- Sélectionnez un type de variable --</option>
                    <option value="FromValuesList">Liste de valeurs autorisées</option>
                    <option value="Constant">Constante</option>
                    <option value="RunDefined">Défini à l'exécution (libre)</option>
                </select>
                
                <div id="var_values_${userVarCounter}" style="display:none;">
                    <label id="var_content_label_${userVarCounter}" for="var_content_${userVarCounter}">Contenu :</label>
                    <textarea id="var_content_${userVarCounter}" name="user_defined_vars[${userVarCounter}][content]" placeholder="" style="width: 100%; resize: none;" rows="5"></textarea>
                </div>
                
                <button type="button" onclick="removeUserVar(${userVarCounter})">Supprimer</button>
            `;
            container.appendChild(div);
            userVarCounter++;
        }

        function removeUserVar(index) {
            const element = document.getElementById(`var_name_${index}`).parentElement;
            element.remove();
        }

        function updateVarType(index) {
            const typeSelect = document.getElementById(`var_type_${index}`);
            const valuesDiv = document.getElementById(`var_values_${index}`);
            const textarea = document.getElementById(`var_content_${index}`);
            const contentLabel = document.getElementById(`var_content_label_${index}`);

            if (typeSelect.value) {
                valuesDiv.style.display = 'block';
                contentLabel.style.display = 'inline';

                if (typeSelect.value === 'FromValuesList') {
                    textarea.style.display = 'inline';
                    textarea.placeholder = 'Entrez une valeur par ligne';
                } else if (typeSelect.value === 'Constant') {
                    textarea.style.display = 'inline';
                    textarea.placeholder = 'Entrez la valeur constante';
                } else if (typeSelect.value === 'RunDefined') {
                    textarea.style.display = 'none';
                    contentLabel.style.display = 'none';
                }
            } else {
                valuesDiv.style.display = 'none';
                contentLabel.style.display = 'none';
            }
        }

        window.onload = function () {
            init();
            addUserVar();
            load_groups();
            updateValues();
        };

        function init() {
            userVarCounter = 0;
            pendingGroups = [];
        }
    </script>

    <script>
        function submitForm() {
            const pipelineName = document.getElementById("pipeline_name").value;
            const launcherName = document.getElementById("launcher_name").value;
            const formName = document.getElementById("form_name").value;

            const selectedGroups = Array.from(
                document.querySelectorAll('input[name="selected_groups"]:checked')
            ).map((input) => {
                const groupId = parseInt(input.value);
                const groupName = input.nextElementSibling?.textContent?.trim() || "Nom inconnu";
                return { id: groupId, name: groupName };
            });

            const userVars = {};
            document.querySelectorAll(".user-var-item").forEach((item) => {
                const varName = item.querySelector('input[type="text"]').value;
                const varType = item.querySelector("select").value;
                const varContent = item.querySelector("textarea")?.value || null;

                userVars[varName] = {};
                if (varType === "FromValuesList") {
                    userVars[varName][varType] = { allowed: varContent.split("\n") };
                }
                if (varType === "RunDefined") {
                    userVars[varName][varType] = null;
                }
                if (varType === "Constant") {
                    userVars[varName][varType] = varContent;
                }

            });

            if (Object.keys(userVars).length === 0) {
                userVars = null;
            }

            const formData = {
                pipeline_name: pipelineName,
                launcher_name: launcherName,
                form_name: formName,
                groups: selectedGroups,
                user_defined_vars: userVars,
            };

            fetch("/mercure/api/newform", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(formData),
            })
                .then((response) => {
                    if (response.ok) {
                        alert("Formulaire soumis avec succès.");
                    } else {
                        alert("Erreur lors de la soumission du formulaire.");
                    }
                })
                .catch((error) => {
                    console.error("Erreur:", error);
                    alert("Erreur lors de la soumission du formulaire.");
                });
        }
    </script>

</head>

<body>
    <h1 class="title">Nouveau formulaire de pipeline</h1>
    <form>
        <div>
            <label for="pipeline_name">Pipeline :</label>
            <select id="pipeline_name" name="pipeline_name" onchange="updateValues()" required>
                <option value="">-- Sélectionnez un pipeline --</option>
                {% for key in pipelines_struct %}
                <option value="{{ key }}">{{ key }}</option>
                {% endfor %}
            </select>
        </div>

        <div id="launcher-container" style="display:none;">
            <label for="launcher_name">Launcher :</label>
            <select id="launcher_name" name="launcher_name" required>
                <!-- Options will be populated by JS -->
            </select>
        </div>

        <div>
            <label for="form_name">Nom du formulaire :</label>
            <input type="text" id="form_name" name="form_name" required>
        </div>

        <fieldset>
            <legend>Groupes</legend>
            <div id="groups-container">
            </div>
            <div>
                <label for="new_group_name">Créer un nouveau groupe :</label>
                <input type="text" id="new_group_name" name="new_group_name" placeholder="Nom du nouveau groupe">
                <button type="button" onclick="addNewGroup()">Ajouter</button>
            </div>
        </fieldset>

        <div>
            <h3 class="title">Variables définies par l'utilisateur</h3>
            <div id="user-vars-container">
            </div>
            <button type="button" onclick="addUserVar()">Ajouter une variable</button>
        </div>
    </form>

    <!-- Centered submit button at the bottom of the page -->
    <div style="text-align: center; margin-top: 20px;">
        <button class="btn btn-primary" onclick="onSubmit()">Envoyer</button>
    </div>

    <script>
        // Show/hide launcher container based on pipeline selection
        document.getElementById('pipeline_name').addEventListener('change', function () {
            var launcherContainer = document.getElementById('launcher-container');
            if (this.value) {
                launcherContainer.style.display = 'block';
            } else {
                launcherContainer.style.display = 'none';
            }
        });
    </script>
</body>

</html>