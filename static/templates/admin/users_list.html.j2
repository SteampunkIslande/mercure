<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des utilisateurs</title>
    <link rel="stylesheet" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

        table th,
        table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        table th {
            background-color: #f1f1f1;
        }

        table tbody tr:hover {
            background-color: #f1f1f1;
        }

        table a {
            display: inline-block;
            padding: 5px 10px;
            text-decoration: none;
            color: white;
            background-color: #007bff;
            border-radius: 4px;
        }

        table a:hover {
            background-color: #0056b3;
        }

        table a:hover {
            background-color: #0056b3;
        }

        table td:hover a {
            background-color: #0056b3;
        }
    </style>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Liste des utilisateurs</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>Nom de l'utilisateur</th>
                <th>Groupe</th>
                <th>Mot de passe</th>
            </tr>
        </thead>
        <tbody id="user-list">
            <!-- Rows will be dynamically populated -->
        </tbody>
    </table>
    <script>
        async function fetchUsers() {
            try {
                const response = await fetch('/mercure/api/users/list');
                const data = await response.json();

                if (data && data.data) {
                    const userList = document.getElementById('user-list');
                    data.data.forEach(user => {
                        const row = document.createElement('tr');

                        const nameCell = document.createElement('td');
                        nameCell.textContent = user.username;
                        row.appendChild(nameCell);

                        const groupEditCell = document.createElement('td');
                        const groupEditLink = document.createElement('a');
                        groupEditLink.href = `/mercure/admin/groupedit/${user.id}`;
                        groupEditLink.textContent = 'Editer le groupe';
                        groupEditCell.appendChild(groupEditLink);
                        row.appendChild(groupEditCell);

                        const passEditCell = document.createElement('td');
                        const passEditLink = document.createElement('a');
                        passEditLink.href = `/mercure/passedit/${user.id}`;
                        passEditLink.textContent = 'Modifier le mot de passe';
                        passEditCell.appendChild(passEditLink);
                        row.appendChild(passEditCell);

                        userList.appendChild(row);
                    });
                }
            } catch (error) {
                console.error('Error fetching user list:', error);
            }
        }

        // Fetch users on page load
        fetchUsers();
    </script>
    <div style="text-align: center; margin-top: 20px;">
        <a href="/mercure/admin/dashboard" class="btn btn-secondary">Retour au tableau de bord</a>
    </div>
</body>

</html>