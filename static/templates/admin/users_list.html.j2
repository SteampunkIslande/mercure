{% extends "base.html.j2" %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block banner_text %}Liste des utilisateurs{% endblock %}

{% block content %}
    <table>
        <thead>
            <tr>
                <th class="padding-x centered">Nom de l'utilisateur</th>
                <th class="padding-x centered">Groupe</th>
                <th class="padding-x centered">Mot de passe</th>
            </tr>
        </thead>
        <tbody id="user-list">
            <!-- Rows will be dynamically populated -->
        </tbody>
    </table>
    <div style="text-align: left; margin-top: 20px;">
        <a href="/mercure/admin/dashboard" class="btn btn-secondary">Retour au tableau de bord</a>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        async function fetchUsers() {
            try {
                const response = await fetch('/mercure/api/users/list');
                const data = await response.json();

                if (isApiSuccess(data) && getApiData(data)) {
                    const users = getApiData(data);
                    const userList = document.getElementById('user-list');
                    users.forEach(user => {
                        const row = document.createElement('tr');

                        const nameCell = document.createElement('td');
                        nameCell.innerHTML = user.username + (user.is_admin ? ' (Admin <span class="material-icons icon-align" style="font-size: 1rem; color: #ff0000;">shield</span>)' : '');
                        row.appendChild(nameCell);

                        const groupEditCell = document.createElement('td');
                        const groupEditLink = document.createElement('a');
                        groupEditLink.href = `/mercure/admin/groupedit/${user.id}`;
                        groupEditLink.textContent = 'Editer les groupes';
                        groupEditLink.className = "inline-table centered";
                        groupEditCell.appendChild(groupEditLink);
                        row.appendChild(groupEditCell);

                        const passEditCell = document.createElement('td');
                        const passEditLink = document.createElement('a');
                        passEditLink.href = `/mercure/passedit/${user.id}`;
                        passEditLink.textContent = 'Modifier le mot de passe';
                        passEditLink.className = "inline-table centered";
                        passEditCell.appendChild(passEditLink);
                        row.appendChild(passEditCell);

                        userList.appendChild(row);
                    });
                }
            } catch (error) {
                console.error('Error fetching user list:', error);
            }
        }

        // Fetch users on page load
        document.addEventListener("DOMContentLoaded", async () => { await fetchUsers() });
    </script>
{% endblock %}
