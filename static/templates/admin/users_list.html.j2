{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Utilisateurs | SMAUG{% endblock %}
{% block body_class %}admin-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Administration</p>
    <h1>Utilisateurs</h1>
    <p>Gérez les comptes, les groupes et les mots de passe.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/smaug/admin/register">{{ ui.icon("user-plus") }}Créer un utilisateur</a>
    <a class="btn btn-ghost" href="/smaug/admin/dashboard">{{ ui.icon("arrow-left") }}Tableau de bord</a>
  </div>
</header>

<section class="panel">
  <div class="panel-title">
    <div>{{ ui.icon("users", "section-icon") }}<h2>Comptes</h2></div>
    <span class="soft-badge" id="users-count"></span>
  </div>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr><th>Utilisateur</th><th>Groupes</th><th>Mot de passe</th></tr>
      </thead>
      <tbody id="user-list">
        <tr><td colspan="3" class="empty-state">Chargement des utilisateurs…</td></tr>
      </tbody>
    </table>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/admin-users.js"></script>
{% endblock %}
