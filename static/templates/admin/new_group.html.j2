{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Nouveau groupe | SMAUG{% endblock %}
{% block body_class %}admin-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Administration · groupes</p>
    <h1>Nouveau groupe</h1>
    <p>Créez un groupe d’accès aux formulaires.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/admin/dashboard">{{ ui.icon("arrow-left") }}Tableau de bord</a>
  </div>
</header>

<section class="panel form-card">
  <div class="panel-title">
    <div>{{ ui.icon("plus", "section-icon") }}<h2>Nom du groupe</h2></div>
  </div>
  <form id="new-group-form" class="form">
    <div class="field">
      <label for="new-group-name">Nom du nouveau groupe</label>
      <input id="new-group-name" name="new_group_name" type="text" required>
    </div>
    <div class="form-actions">
      <button id="create-group" class="btn" type="submit">{{ ui.icon("plus") }}Créer le groupe</button>
      <a class="btn btn-secondary" href="/smaug/admin/dashboard">Annuler</a>
    </div>
  </form>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/admin-new-group.js"></script>
{% endblock %}
