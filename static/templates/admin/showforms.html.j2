<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Forms</title>
    <link rel="stylesheet" href="/static/styles/default.css">
    <link rel="stylesheet" type="text/css" href="/static/icon-font/material-icons.css">
    <script src="/static/scripts/utils.js"></script>
</head>

<body>
    <div class="banner">
        <div class="banner-content">
            <span class="banner-text">Liste des formulaires par groupe</span>
            <div class="logout-button">
                <a href="/mercure/logout" class="btn btn-danger"><span
                        class="material-icons icon-align">logout</span>Déconnexion</a>
            </div>
        </div>
    </div>

    <div class="tab">
        {% for group in user_groups %}

        <button id="tab-{{ group.id }}" class="tablinks{% if loop.first %} active {% endif %}"
            onclick="openTab(event,{{ group.id }})">{{ group.name
            }}</button>
        {% endfor %}

        {% if is_admin %}
        <button id="tab-no-group" class="tablinks" onclick="openTab(event,`no-group`)">Formulaires sans groupe</button>
        {% endif %}
    </div>

    {% for group in user_groups %}
    <table id="forms-container-{{ group.id }}" class="tabcontent" {% if loop.first %} style="display: block;" {% endif
        %}>
        <tr>
            <th>Nom du formulaire</th>
            <th style="min-width: max-content;padding-inline:30px;">Formulaire actif</th>
            <th style="min-width: max-content;padding-inline:30px;">Edition du formulaire</th>
        </tr>
    </table>
    {% endfor %}
    {% if is_admin %}
    <table id="forms-container-no-group" class="tabcontent" style="display: none;">
        <tr>
            <th>Nom du formulaire</th>
            <th style="min-width: max-content;padding-inline:30px;">Formulaire actif</th>
            <th style="min-width: max-content;padding-inline:30px;">Edition du formulaire</th>
        </tr>
    </table>
    {% endif %}

    <script>
        function openTab(evt, group_id) {
            // Declare all variables
            var i, tabcontent, tablinks;

            // Get all elements with class="tabcontent" and hide them
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }

            // Get all elements with class="tablinks" and remove the class "active"
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }

            // Show the current tab, and add an "active" class to the button that opened the tab
            document.getElementById(`forms-container-${group_id}`).style.display = "block";
            evt.currentTarget.className += " active";
        } 
    </script>

    <script>
        const userGroups = {{ user_groups | tojson }};
        userGroups.forEach((group, index, _) => {
            fetch(`/mercure/api/forms/groups/${group.id}`)
                .then(response => response.json())
                .then(forms => {
                    // Always append to tbody if present, otherwise to table
                    let table = document.getElementById(`forms-container-${group.id}`);
                    let container = table.querySelector('tbody');
                    if (!container) {
                        console.log("No tbody found, appending to table directly");
                        container = table;
                    }
                    forms.data.with_group.forEach(form => {
                        const formBox = document.createElement('tr');
                        formBox.innerHTML = `
                            <td>${form.form_name} (version ${form.version})</td>
                            <td>
                                <input type="checkbox" onclick="toggleFormActive(event,'${form.formid}')" ${form.enabled ? 'checked' : ''}>
                                Actif
                            </td>
                            <td>
                                <a href="/mercure/admin/editform/${form.formid}" style="display:inline-table;width:100%;text-align:center;">Editer le formulaire</a>
                            </td>
                        `;
                        container.appendChild(formBox);
                    });
                    {% if is_admin %}
                    if (index == 0) {
                        let table_no_group = document.getElementById(`forms-container-no-group`);
                        let container_no_group = table_no_group.querySelector('tbody');
                        if (!container_no_group) {
                            console.log("No tbody found, appending to table directly");
                            container_no_group = table_no_group;
                        }
                        forms.data.without_group.forEach(form => {
                            const formBoxNoGroup = document.createElement('tr');
                            formBoxNoGroup.innerHTML = `
                                <td>${form.form_name} (version ${form.version})</td>
                                <td>
                                    <input type="checkbox" onclick="toggleFormActive(event,'${form.formid}')" ${form.enabled ? 'checked' : ''}>
                                    Actif
                                </td>
                                <td>
                                    <a href="/mercure/admin/editform/${form.formid}" style="display:inline-table;width:100%;text-align:center;">Editer le formulaire</a>
                                </td>
                            `;
                            container_no_group.appendChild(formBoxNoGroup);
                        });
                    }
                    {% endif %}
                })
                .catch(error => console.error('Error fetching forms:', error));
        });

        function toggleFormActive(e, formId) {
            let toggle = e.target.checked ? "enable" : "disable";
            fetch(`/mercure/api/${toggle}/${formId}`)
                .then(response => response.json())
                .then(
                    data => {
                        if (data.success) {
                            const infodiv = document.getElementById("info-message")
                            infodiv.style.display = "block";
                            infodiv.textContent = data.data;
                            setTimeout(() => {
                                infodiv.style.display = 'none';
                            }, 2000);
                        }
                        else {
                            const errordiv = document.getElementById("error-message")
                            errordiv.style.display = "block";
                            errordiv.textContent = data.message;
                            setTimeout(() => {
                                errordiv.style.display = 'none';
                            }, 2000);
                        }
                    }
                ).catch(error => {
                    const errordiv = document.getElementById("error-message")
                    errordiv.style.display = "block";
                    errordiv.textContent = error;
                    setTimeout(() => {
                        errordiv.style.display = 'none';
                    }, 2000);
                })
                ;
        }
    </script>
    <a href="/mercure/admin/dashboard" class="btn btn-secondary">Retour au tableau de bord</a>
    <div class="error" id="error-message" style="display: none;"></div>
    <div class="info" id="info-message" style="display: none;"></div>
</body>

</html>