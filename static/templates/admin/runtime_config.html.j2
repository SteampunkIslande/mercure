{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% set enum_labels = {
    "on_sigint": {
        "StopJobs": "Arrêter les jobs",
        "WaitForJobCompletion": "Attendre la fin des jobs"
    },
    "active_routine": {
        "RoutineOff": "Routine désactivée",
        "RoutineOn": "Routine activée"
    }
} %}

{% block title %}Configuration d’exécution | SMAUG{% endblock %}
{% block body_class %}admin-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Administration</p>
    <h1>Configuration d’exécution</h1>
    <p>Ces variables contrôlent le comportement de l’application au runtime. Les modifications prennent effet immédiatement.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/admin/dashboard">{{ ui.icon("arrow-left") }}Tableau de bord</a>
  </div>
</header>

<section class="panel">
  <div class="panel-title">
    <div>{{ ui.icon("sliders", "section-icon") }}<h2>Variables</h2></div>
  </div>
  <div class="table-scroll">
    <table class="config-table">
      <thead>
        <tr><th>Variable</th><th>Description</th><th>Valeur</th><th>Action</th></tr>
      </thead>
      <tbody id="config-body">
        {% for entry in entries %}
        {% set labels = enum_labels[entry.key] | default({}) %}
        <tr data-config-row="{{ entry.key }}">
          <td class="config-key">{{ entry.key }}</td>
          <td>{{ entry.description }}</td>
          <td>
            {% if entry.value_input is string and entry.value_input == "date" %}
            <input type="date" name="{{ entry.key }}" value="{{ entry.value | e }}">
            {% else %}
            <select name="{{ entry.key }}">
              {% for option in entry.value_input %}
              <option value="{{ option }}"{% if option == entry.value %} selected{% endif %}>{{ labels[option] | default(option) }}</option>
              {% endfor %}
            </select>
            {% endif %}
          </td>
          <td><button type="button" class="btn btn-sm" data-config-key="{{ entry.key }}">Sauvegarder</button></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/admin-runtime-config.js"></script>
{% endblock %}
