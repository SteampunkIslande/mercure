{% extends "base.html.j2" %}
{% import "_macros.html.j2" as ui %}

{% block title %}Groupes de {{ edited_user.username }} | SMAUG{% endblock %}
{% block body_class %}admin-page{% endblock %}

{% block content %}
<header class="page-head">
  <div>
    <p class="eyebrow">Administration · groupes</p>
    <h1>Groupes de {{ edited_user.username }}</h1>
    <p>Cochez les groupes auxquels cet utilisateur doit appartenir.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/smaug/admin/editusers">{{ ui.icon("arrow-left") }}Utilisateurs</a>
  </div>
</header>

<section id="groups-container" class="panel form-card" data-user-id="{{ edited_user.id }}">
  <div class="panel-title">
    <div>{{ ui.icon("network", "section-icon") }}<h2>Groupes disponibles</h2></div>
  </div>
  <div id="group-list" class="check-grid" aria-live="polite">
    <p class="empty-state">Chargement des groupes…</p>
  </div>
  <div class="form-actions">
    <button id="save-groups" type="button" class="btn">{{ ui.icon("save") }}Mettre à jour les groupes</button>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/smaug/static/js/pages/admin-groups.js"></script>
{% endblock %}
