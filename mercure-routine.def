Bootstrap: docker
From: alpine:latest

%files
    target/x86_64-unknown-linux-musl/release/mercure /bin/mercure
    target/x86_64-unknown-linux-musl/release/routine /bin/routine
    target/x86_64-unknown-linux-musl/release/admin /bin/admin
    static /static
    Rocket.toml /Rocket.toml

%startscript
    cd /
    routine

